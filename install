#!/usr/bin/env bash
#
# Clone selected Teemill GitHub repositories into ~/teemill (or $TEEMILL_ROOT / --root).
# Clones use SSH (git@github.com:Teemill/…). frontend and frontend-legacy clones use
# git clone --filter=blob:none to keep the initial download small. Toolchain is a multi-select step (same UX as repos: arrows,
# Space toggles, Enter confirms; numbered fallback): defaults on for curl, git, gh, gcloud, docker;
# kubectl, helm, and terraform are optional (off by default). Shows a version summary for selected tools,
# then installs (Linux: distro Docker packages + docker group for passwordless CLI; macOS: Homebrew when available).
# --yes skips prompts and uses
# default toolchain ids plus default repo clone set. --dry-run prints resolved toolchain package names
# and git clone commands instead of mutating the system.
# gcloud auth login runs when gcloud is on PATH (after toolchain install or if already installed), except
# --dry-run; git/gh + GitHub SSH + gh login follow when a TTY allows it.
# On Ubuntu (strict ID=ubuntu from /etc/os-release) with GNOME Shell, optionally resets the dock favorites
# to default browser + IDE + terminal via gsettings (org.gnome.shell favorite-apps) when those .desktop
# entries can be resolved (browser from the desktop default, IDE from the first installed cursor.desktop or
# jetbrains-toolbox.desktop when ide_choice is skip).
# Interactive repo list: arrow keys move, Space toggles, Enter confirms.
# Falls back to typing numbers if /dev/tty is not usable.
#
# Remote install (fresh machine; creates ~/teemill, then default toolchain + default repos with --yes):
#   curl -fsSL https://raw.githubusercontent.com/<org>/dev-starter-kit/<branch>/install | bash -s -- --yes
# Pass flags after -- e.g.  bash -s -- --list
#
# When piping the script into bash, stdin is the script body — all prompts read from /dev/tty.

set -u

trap '' PIPE

readonly DEFAULT_TEEMILL_ROOT="${TEEMILL_ROOT:-$HOME/teemill}"

# -----------------------------------------------------------------------------
# Layout: shared helpers → toolchain (versions, dry-run, installers) →
# gcloud / git+gh → Ubuntu GNOME dock → manifests → interactive menus → main.
# -----------------------------------------------------------------------------

# stderr: separate prior output from a major step (blank line + banner).
_teemill_install_major_step() {
  echo "" >&2
  echo "teemill-install: --- $1 ---" >&2
}

# Run a package-manager command as root when this script is not already root.
_pkg_as_root() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "teemill-install: need root or sudo to install packages." >&2
    return 1
  fi
}

# stdout: response body, or empty string on failure (no stderr from curl/wget).
_http_get_body() {
  local url="${1:?}"
  local connect_seconds="${2:-6}"
  local max_seconds="${3:-25}"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout "$connect_seconds" --max-time "$max_seconds" "$url" 2>/dev/null || true

    return 0
  fi

  if command -v wget >/dev/null 2>&1; then
    wget -qO- --timeout="$max_seconds" "$url" 2>/dev/null || true
  fi
}

# GitHub REST: include Accept + User-Agent so anonymous API calls behave reliably.
_http_get_github_json_body() {
  local url="${1:?}"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 6 --max-time 22 \
      -H 'Accept: application/vnd.github+json' \
      -H 'User-Agent: teemill-install' \
      "$url" 2>/dev/null || true

    return 0
  fi

  if command -v wget >/dev/null 2>&1; then
    wget -qO- --timeout=25 "$url" 2>/dev/null || true
  fi
}

_installed_version_curl() {
  command -v curl >/dev/null 2>&1 || {
    echo ""
    return
  }
  curl --version 2>/dev/null | head -n1 | sed -E 's/^curl ([0-9][0-9.]*).*/\1/'
}

_installed_version_git() {
  command -v git >/dev/null 2>&1 || {
    echo ""
    return
  }
  git --version 2>/dev/null | sed -E 's/.*git version ([0-9][0-9.]*).*/\1/'
}

_installed_version_gh() {
  command -v gh >/dev/null 2>&1 || {
    echo ""
    return
  }
  gh version 2>/dev/null | head -n1 | sed -E 's/^gh version ([0-9][0-9.]*).*/\1/'
}

_installed_version_gcloud_sdk() {
  command -v gcloud >/dev/null 2>&1 || {
    echo ""
    return
  }
  gcloud version 2>/dev/null | sed -n 's/^Google Cloud SDK \([0-9][0-9.]*\).*/\1/p' | head -n1
}

_installed_version_docker() {
  command -v docker >/dev/null 2>&1 || {
    echo ""
    return
  }
  docker --version 2>/dev/null | sed -E 's/.*version ([0-9][0-9.]*).*/\1/' | head -n1
}

_installed_version_kubectl() {
  command -v kubectl >/dev/null 2>&1 || {
    echo ""
    return
  }
  kubectl version --client=true -o json 2>/dev/null | grep -m1 -oE '"gitVersion"[[:space:]]*:[[:space:]]*"v[^"]+"' | grep -oE 'v[0-9][^"]*' | sed 's/^v//' | head -n1
}

_installed_version_helm() {
  command -v helm >/dev/null 2>&1 || {
    echo ""
    return
  }
  helm version --short 2>/dev/null | sed -E 's/^v([0-9][0-9.]*).*/\1/' | head -n1
}

_installed_version_terraform() {
  command -v terraform >/dev/null 2>&1 || {
    echo ""
    return
  }
  terraform version -json 2>/dev/null | grep -m1 -oE '"terraform_version"[[:space:]]*:[[:space:]]*"[^"]+"' | grep -oE '[0-9][0-9.]*' | head -n1
}

# Reads GitHub API "tag_name" from a releases/latest JSON response (no jq).
# Uses curl when available, otherwise wget, so version checks work before curl is installed.
_json_curl_release_tag_name() {
  local url="$1"
  local body

  body="$(_http_get_github_json_body "$url")"

  echo "$body" | grep -m1 -oE '"tag_name"[[:space:]]*:[[:space:]]*"[^"]+"' | sed -E 's/.*"([^"]+)".*/\1/' | sed -E 's/^v//'
}

_latest_upstream_curl_tag() {
  _json_curl_release_tag_name "https://api.github.com/repos/curl/curl/releases/latest"
}

_latest_upstream_git_tag() {
  _json_curl_release_tag_name "https://api.github.com/repos/git/git/releases/latest"
}

_latest_upstream_gh_tag() {
  _json_curl_release_tag_name "https://api.github.com/repos/cli/cli/releases/latest"
}

_latest_upstream_gcloud_version() {
  local body

  body="$(_http_get_body "https://dl.google.com/dl/cloudsdk/channels/rapid/components-2.json" 6 28)"

  echo "$body" | head -c 196608 | grep -m1 -oE '"version"[[:space:]]*:[[:space:]]*"[0-9][0-9.]*"' | grep -oE '[0-9][0-9.]*' | head -n1
}

_latest_upstream_kubectl_version() {
  local stable

  stable="$(_http_get_body "https://storage.googleapis.com/kubernetes-release/release/stable.txt" 5 20)"

  echo "${stable#v}"
}

_latest_upstream_helm_tag() {
  _json_curl_release_tag_name "https://api.github.com/repos/helm/helm/releases/latest"
}

_latest_upstream_terraform_tag() {
  _json_curl_release_tag_name "https://api.github.com/repos/hashicorp/terraform/releases/latest"
}

_version_is_strictly_older() {
  local installed="$1"
  local latest="$2"

  [[ -z "$latest" ]] && return 1
  [[ -z "$installed" ]] && return 0
  [[ "$installed" == "$latest" ]] && return 1
  local first
  first="$(printf '%s\n' "$installed" "$latest" | sort -V | head -n1)"
  [[ "$first" == "$installed" ]]
}

_selected_line_contains_tool_id() {
  local selected_line="$1"
  local id="$2"
  local token

  for token in $selected_line; do
    if [[ "$token" == "$id" ]]; then
      return 0
    fi
  done

  return 1
}

# Prints a version table for the space-separated tool ids in selected_line (no y/n prompt).
_print_selected_toolchain_version_summary() {
  local selected_line="$1"
  local assume_yes="$2"
  local cur_curl cur_git cur_gh cur_gc cur_docker cur_kubectl cur_helm cur_terraform
  local lat_curl lat_git lat_gh lat_gc lat_kubectl lat_helm lat_terraform

  _teemill_install_major_step "Toolchain: version summary (selected tools)"
  echo "" >&2
  echo "------------------------------------------------------------------------------" >&2
  printf '%-10s  %-18s  %-18s  %s\n' "Tool" "Installed" "Upstream latest" "Note" >&2
  printf '%-10s  %-18s  %-18s  %s\n' "----------" "------------------" "------------------" "----" >&2

  cur_curl="$(_installed_version_curl)"
  cur_git="$(_installed_version_git)"
  cur_gh="$(_installed_version_gh)"
  cur_gc="$(_installed_version_gcloud_sdk)"
  cur_docker="$(_installed_version_docker)"
  cur_kubectl="$(_installed_version_kubectl)"
  cur_helm="$(_installed_version_helm)"
  cur_terraform="$(_installed_version_terraform)"

  lat_curl="$(_latest_upstream_curl_tag)"
  lat_git="$(_latest_upstream_git_tag)"
  lat_gh="$(_latest_upstream_gh_tag)"
  lat_gc="$(_latest_upstream_gcloud_version)"
  lat_kubectl="$(_latest_upstream_kubectl_version)"
  lat_helm="$(_latest_upstream_helm_tag)"
  lat_terraform="$(_latest_upstream_terraform_tag)"

  if _selected_line_contains_tool_id "$selected_line" "curl"; then
    printf '%-10s  %-18s  %-18s  %s\n' "curl" "${cur_curl:-(none)}" "${lat_curl:-(unknown)}" "curl releases (GitHub)" >&2
  fi

  if _selected_line_contains_tool_id "$selected_line" "git"; then
    printf '%-10s  %-18s  %-18s  %s\n' "git" "${cur_git:-(none)}" "${lat_git:-(unknown)}" "Package feed / OS" >&2
  fi

  if _selected_line_contains_tool_id "$selected_line" "gh"; then
    printf '%-10s  %-18s  %-18s  %s\n' "gh" "${cur_gh:-(none)}" "${lat_gh:-(unknown)}" "GitHub CLI releases" >&2
  fi

  if _selected_line_contains_tool_id "$selected_line" "gcloud"; then
    printf '%-10s  %-18s  %-18s  %s\n' "gcloud" "${cur_gc:-(none)}" "${lat_gc:-(unknown)}" "Rapid channel manifest" >&2
  fi

  if _selected_line_contains_tool_id "$selected_line" "docker"; then
    printf '%-10s  %-18s  %-18s  %s\n' "docker" "${cur_docker:-(none)}" "(distro)" "docker.io / distro; user added to docker group (re-login for no sudo)" >&2
  fi

  if _selected_line_contains_tool_id "$selected_line" "kubectl"; then
    printf '%-10s  %-18s  %-18s  %s\n' "kubectl" "${cur_kubectl:-(none)}" "${lat_kubectl:-(unknown)}" "stable.txt (client skew vs distro)" >&2
  fi

  if _selected_line_contains_tool_id "$selected_line" "helm"; then
    printf '%-10s  %-18s  %-18s  %s\n' "helm" "${cur_helm:-(none)}" "${lat_helm:-(unknown)}" "Helm GitHub releases" >&2
  fi

  if _selected_line_contains_tool_id "$selected_line" "terraform"; then
    printf '%-10s  %-18s  %-18s  %s\n' "terraform" "${cur_terraform:-(none)}" "${lat_terraform:-(unknown)}" "HashiCorp GitHub releases" >&2
  fi

  echo "------------------------------------------------------------------------------" >&2

  if _selected_line_contains_tool_id "$selected_line" "curl"; then
    if [[ -n "$cur_curl" && -n "$lat_curl" ]] && _version_is_strictly_older "$cur_curl" "$lat_curl"; then
      echo "teemill-install: warning: curl ${cur_curl} is older than latest upstream release ${lat_curl} (distro packages may lag)." >&2
    fi
  fi

  if _selected_line_contains_tool_id "$selected_line" "git"; then
    if [[ -n "$cur_git" && -n "$lat_git" ]] && _version_is_strictly_older "$cur_git" "$lat_git"; then
      echo "teemill-install: warning: git ${cur_git} is older than upstream release ${lat_git} (distro packages may lag)." >&2
    fi
  fi

  if _selected_line_contains_tool_id "$selected_line" "gh"; then
    if [[ -n "$cur_gh" && -n "$lat_gh" ]] && _version_is_strictly_older "$cur_gh" "$lat_gh"; then
      echo "teemill-install: warning: gh ${cur_gh} is older than latest GitHub release ${lat_gh}." >&2
    fi
  fi

  if _selected_line_contains_tool_id "$selected_line" "gcloud"; then
    if [[ -n "$cur_gc" && -n "$lat_gc" ]] && _version_is_strictly_older "$cur_gc" "$lat_gc"; then
      echo "teemill-install: warning: Google Cloud SDK ${cur_gc} is older than rapid channel ${lat_gc}." >&2
    fi
  fi

  echo "" >&2
  echo "Next step: install or upgrade selected tools using apt, Homebrew, dnf, pacman, apk, yum, or zypper (where supported)." >&2

  if [[ "$assume_yes" == "true" ]]; then
    echo "teemill-install: --yes set; proceeding without further toolchain prompts." >&2
  fi
}

_dry_run_summarize_homebrew_plan() {
  local want="$1"
  local -a formulas=()
  local -a parts=()

  _selected_line_contains_tool_id "$want" "curl" && formulas+=(curl)
  _selected_line_contains_tool_id "$want" "git" && formulas+=(git)
  _selected_line_contains_tool_id "$want" "gh" && formulas+=(gh)
  _selected_line_contains_tool_id "$want" "kubectl" && formulas+=(kubectl)
  _selected_line_contains_tool_id "$want" "helm" && formulas+=(helm)
  _selected_line_contains_tool_id "$want" "terraform" && formulas+=(terraform)

  if [[ "${#formulas[@]}" -gt 0 ]]; then
    parts+=("brew install ${formulas[*]}")
  fi

  if _selected_line_contains_tool_id "$want" "gcloud"; then
    parts+=("brew install --cask google-cloud-sdk")
  fi

  if _selected_line_contains_tool_id "$want" "docker"; then
    parts+=("brew install docker")
  fi

  if [[ "${#parts[@]}" -eq 0 ]]; then
    echo "(no Homebrew formulas/casks for this selection)"

    return
  fi

  (IFS='; '; echo "${parts[*]}")
}

_print_toolchain_dry_run_package_plan() {
  local selected_line="$1"

  _teemill_install_major_step "Dry-run: toolchain package plan"
  echo "" >&2
  echo "teemill-install: --dry-run: selected toolchain ids: ${selected_line:-<none>}" >&2

  if [[ -z "${selected_line// }" ]]; then
    echo "teemill-install: --dry-run: no toolchain packages selected; skipping package plan." >&2

    return 0
  fi

  if [[ "$(uname -s)" == "Darwin" ]] && command -v brew >/dev/null 2>&1; then
    echo "teemill-install: --dry-run: Homebrew: $(_dry_run_summarize_homebrew_plan "$selected_line")" >&2

    return 0
  fi

  if command -v apt-get >/dev/null 2>&1; then
    echo "teemill-install: --dry-run: apt packages (best-effort names): $(_dry_run_resolve_toolchain_packages_for_pm_family debian "$selected_line")" >&2

    return 0
  fi

  if command -v dnf >/dev/null 2>&1; then
    echo "teemill-install: --dry-run: dnf packages (best-effort names): $(_dry_run_resolve_toolchain_packages_for_pm_family dnf "$selected_line")" >&2

    return 0
  fi

  if command -v yum >/dev/null 2>&1; then
    echo "teemill-install: --dry-run: yum packages (best-effort names): $(_dry_run_resolve_toolchain_packages_for_pm_family yum "$selected_line")" >&2

    return 0
  fi

  if command -v zypper >/dev/null 2>&1; then
    echo "teemill-install: --dry-run: zypper packages (best-effort names): $(_dry_run_resolve_toolchain_packages_for_pm_family yum "$selected_line")" >&2

    return 0
  fi

  if command -v pacman >/dev/null 2>&1; then
    echo "teemill-install: --dry-run: pacman packages (best-effort names): $(_dry_run_resolve_toolchain_packages_for_pm_family pacman "$selected_line")" >&2

    return 0
  fi

  if command -v apk >/dev/null 2>&1; then
    echo "teemill-install: --dry-run: apk packages (best-effort names): $(_dry_run_resolve_toolchain_packages_for_pm_family apk "$selected_line")" >&2

    return 0
  fi

  echo "teemill-install: --dry-run: unknown package manager; cannot list resolved package names." >&2
}

# family: debian | dnf | yum | pacman | apk  (zypper reuses the yum name set in dry-run output)
_dry_run_resolve_toolchain_packages_for_pm_family() {
  local family="${1:?}"
  local want="${2:?}"
  local -a names=()

  _selected_line_contains_tool_id "$want" "curl" && names+=(curl)
  _selected_line_contains_tool_id "$want" "git" && names+=(git)

  if [[ "$family" == "pacman" || "$family" == "apk" ]]; then
    _selected_line_contains_tool_id "$want" "gh" && names+=(github-cli)
  else
    _selected_line_contains_tool_id "$want" "gh" && names+=(gh)
  fi

  _selected_line_contains_tool_id "$want" "gcloud" && names+=(google-cloud-cli)

  if [[ "$family" == "debian" ]]; then
    _selected_line_contains_tool_id "$want" "docker" && names+=(docker.io)
  else
    _selected_line_contains_tool_id "$want" "docker" && names+=(docker)
  fi

  if [[ "$family" == "dnf" ]]; then
    _selected_line_contains_tool_id "$want" "kubectl" && names+=("kubectl|kubernetes-client")
  else
    _selected_line_contains_tool_id "$want" "kubectl" && names+=(kubectl)
  fi

  _selected_line_contains_tool_id "$want" "helm" && names+=(helm)
  _selected_line_contains_tool_id "$want" "terraform" && names+=(terraform)

  (IFS=' '; echo "${names[*]}")
}

_debian_apt_cache_has_package() {
  local candidate="$1"

  apt-cache show "$candidate" >/dev/null 2>&1
}

_install_toolchain_debian() {
  local want="$1"

  export DEBIAN_FRONTEND=noninteractive

  local need_google_repo=0
  local need_gh_repo=0

  _selected_line_contains_tool_id "$want" "gcloud" && need_google_repo=1
  _selected_line_contains_tool_id "$want" "gh" && need_gh_repo=1

  _pkg_as_root apt-get update -qq

  if [[ "$need_google_repo" -eq 1 || "$need_gh_repo" -eq 1 ]]; then
    _pkg_as_root apt-get install -y -qq ca-certificates curl gnupg dirmngr apt-transport-https || return 1
  else
    _pkg_as_root apt-get install -y -qq ca-certificates || true
  fi

  local google_list=/etc/apt/sources.list.d/google-cloud-sdk.list
  local google_key=/usr/share/keyrings/google-cloud-teemill.gpg

  if [[ "$need_google_repo" -eq 1 ]]; then
    if [[ ! -f "$google_list" ]]; then
      curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | _pkg_as_root gpg --batch --yes --dearmor -o "$google_key"
      echo "deb [signed-by=${google_key}] https://packages.cloud.google.com/apt cloud-sdk main" | _pkg_as_root tee "$google_list" >/dev/null
    fi
  fi

  local gh_list=/etc/apt/sources.list.d/github-cli.list
  local gh_key=/usr/share/keyrings/githubcli-archive-keyring.gpg

  if [[ "$need_gh_repo" -eq 1 ]]; then
    if [[ ! -f "$gh_list" ]]; then
      if ! command -v dpkg >/dev/null 2>&1; then
        echo "teemill-install: apt-based install requires dpkg (Debian/Ubuntu)." >&2
        return 1
      fi

      curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | _pkg_as_root tee "$gh_key" >/dev/null
      _pkg_as_root chmod go+r "$gh_key" 2>/dev/null || true
      echo "deb [arch=$(dpkg --print-architecture) signed-by=${gh_key}] https://cli.github.com/packages stable main" | _pkg_as_root tee "$gh_list" >/dev/null
    fi
  fi

  if [[ "$need_google_repo" -eq 1 || "$need_gh_repo" -eq 1 ]]; then
    _pkg_as_root apt-get update -qq
  fi

  local -a install_pkgs=()

  _selected_line_contains_tool_id "$want" "curl" && install_pkgs+=(curl)
  _selected_line_contains_tool_id "$want" "git" && install_pkgs+=(git)
  _selected_line_contains_tool_id "$want" "gh" && install_pkgs+=(gh)
  _selected_line_contains_tool_id "$want" "gcloud" && install_pkgs+=(google-cloud-cli)
  # docker.io from default Debian/Ubuntu repos (no Docker CE apt repo; engine is distro-managed).
  _selected_line_contains_tool_id "$want" "docker" && install_pkgs+=(docker.io)

  if _selected_line_contains_tool_id "$want" "kubectl"; then
    if _debian_apt_cache_has_package kubectl; then
      install_pkgs+=(kubectl)
    else
      echo "teemill-install: warning: debian: no apt package kubectl in current sources (skipped)." >&2
    fi
  fi

  if _selected_line_contains_tool_id "$want" "helm"; then
    if _debian_apt_cache_has_package helm; then
      install_pkgs+=(helm)
    else
      echo "teemill-install: warning: debian: no apt package helm in current sources (skipped)." >&2
    fi
  fi

  if _selected_line_contains_tool_id "$want" "terraform"; then
    if _debian_apt_cache_has_package terraform; then
      install_pkgs+=(terraform)
    else
      echo "teemill-install: warning: debian: no apt package terraform in current sources (skipped)." >&2
    fi
  fi

  if [[ "${#install_pkgs[@]}" -eq 0 ]]; then
    echo "teemill-install: debian: nothing to install for this selection." >&2

    return 0
  fi

  _pkg_as_root apt-get install -y -qq "${install_pkgs[@]}"
}

_install_toolchain_homebrew() {
  local want="$1"

  if ! command -v brew >/dev/null 2>&1; then
    echo "teemill-install: Homebrew not found; install https://brew.sh then re-run." >&2
    return 1
  fi

  brew update

  local -a formulas=()

  _selected_line_contains_tool_id "$want" "curl" && formulas+=(curl)
  _selected_line_contains_tool_id "$want" "git" && formulas+=(git)
  _selected_line_contains_tool_id "$want" "gh" && formulas+=(gh)
  _selected_line_contains_tool_id "$want" "kubectl" && formulas+=(kubectl)
  _selected_line_contains_tool_id "$want" "helm" && formulas+=(helm)
  _selected_line_contains_tool_id "$want" "terraform" && formulas+=(terraform)

  if [[ "${#formulas[@]}" -gt 0 ]]; then
    brew install "${formulas[@]}" || brew upgrade "${formulas[@]}"
  fi

  if _selected_line_contains_tool_id "$want" "gcloud"; then
    if command -v gcloud >/dev/null 2>&1; then
      brew upgrade --cask google-cloud-sdk 2>/dev/null || true
    else
      brew install --cask google-cloud-sdk
    fi
  fi

  if _selected_line_contains_tool_id "$want" "docker"; then
    brew install docker || brew upgrade docker
    echo "teemill-install: note: brew install docker provides the Docker CLI only; use Docker Desktop (brew install --cask docker) or Colima/Lima for a local engine if docker run fails." >&2
  fi
}

_dnf_package_available() {
  local candidate="$1"

  dnf list -q --available "$candidate" &>/dev/null || dnf list -q --installed "$candidate" &>/dev/null
}

_install_toolchain_dnf() {
  local want="$1"
  local -a install_pkgs=()

  _selected_line_contains_tool_id "$want" "curl" && install_pkgs+=(curl)
  _selected_line_contains_tool_id "$want" "git" && install_pkgs+=(git)
  _selected_line_contains_tool_id "$want" "gh" && install_pkgs+=(gh)
  _selected_line_contains_tool_id "$want" "gcloud" && install_pkgs+=(google-cloud-cli)
  _selected_line_contains_tool_id "$want" "docker" && install_pkgs+=(docker)

  if _selected_line_contains_tool_id "$want" "kubectl"; then
    if _dnf_package_available kubectl; then
      install_pkgs+=(kubectl)
    elif _dnf_package_available kubernetes-client; then
      install_pkgs+=(kubernetes-client)
    else
      echo "teemill-install: warning: dnf: kubectl / kubernetes-client not found (skipped)." >&2
    fi
  fi

  if _selected_line_contains_tool_id "$want" "helm"; then
    if _dnf_package_available helm; then
      install_pkgs+=(helm)
    else
      echo "teemill-install: warning: dnf: helm not found (skipped)." >&2
    fi
  fi

  if _selected_line_contains_tool_id "$want" "terraform"; then
    if _dnf_package_available terraform; then
      install_pkgs+=(terraform)
    else
      echo "teemill-install: warning: dnf: terraform not found (skipped)." >&2
    fi
  fi

  if [[ "${#install_pkgs[@]}" -eq 0 ]]; then
    echo "teemill-install: dnf: nothing to install for this selection." >&2

    return 0
  fi

  _pkg_as_root dnf install -y "${install_pkgs[@]}"
}

_install_toolchain_pacman() {
  local want="$1"
  local -a install_pkgs=()

  _selected_line_contains_tool_id "$want" "curl" && install_pkgs+=(curl)
  _selected_line_contains_tool_id "$want" "git" && install_pkgs+=(git)
  _selected_line_contains_tool_id "$want" "gh" && install_pkgs+=(github-cli)
  _selected_line_contains_tool_id "$want" "gcloud" && install_pkgs+=(google-cloud-cli)
  _selected_line_contains_tool_id "$want" "docker" && install_pkgs+=(docker)
  _selected_line_contains_tool_id "$want" "kubectl" && install_pkgs+=(kubectl)
  _selected_line_contains_tool_id "$want" "helm" && install_pkgs+=(helm)
  _selected_line_contains_tool_id "$want" "terraform" && install_pkgs+=(terraform)

  if [[ "${#install_pkgs[@]}" -eq 0 ]]; then
    echo "teemill-install: pacman: nothing to install for this selection." >&2

    return 0
  fi

  if ! _pkg_as_root pacman -S --noconfirm --needed "${install_pkgs[@]}"; then
    local -a without_gcloud=()

    for pkg in "${install_pkgs[@]}"; do
      [[ "$pkg" == "google-cloud-cli" ]] && continue
      without_gcloud+=("$pkg")
    done

    if [[ "${#without_gcloud[@]}" -gt 0 ]]; then
      _pkg_as_root pacman -S --noconfirm --needed "${without_gcloud[@]}" || return 1
    fi

    if _selected_line_contains_tool_id "$want" "gcloud"; then
      echo "teemill-install: pacman: google-cloud-cli install failed; install gcloud from Google docs if needed." >&2
    fi
  fi
}

_install_toolchain_apk() {
  local want="$1"
  local -a install_pkgs=()

  _selected_line_contains_tool_id "$want" "curl" && install_pkgs+=(curl)
  _selected_line_contains_tool_id "$want" "git" && install_pkgs+=(git)
  _selected_line_contains_tool_id "$want" "gh" && install_pkgs+=(github-cli)
  _selected_line_contains_tool_id "$want" "gcloud" && install_pkgs+=(google-cloud-cli)
  _selected_line_contains_tool_id "$want" "docker" && install_pkgs+=(docker)
  _selected_line_contains_tool_id "$want" "kubectl" && install_pkgs+=(kubectl)
  _selected_line_contains_tool_id "$want" "helm" && install_pkgs+=(helm)
  _selected_line_contains_tool_id "$want" "terraform" && install_pkgs+=(terraform)

  if [[ "${#install_pkgs[@]}" -eq 0 ]]; then
    echo "teemill-install: apk: nothing to install for this selection." >&2

    return 0
  fi

  if ! _pkg_as_root apk add --no-cache "${install_pkgs[@]}"; then
    local -a without_gcloud=()

    for pkg in "${install_pkgs[@]}"; do
      [[ "$pkg" == "google-cloud-cli" ]] && continue
      without_gcloud+=("$pkg")
    done

    if [[ "${#without_gcloud[@]}" -gt 0 ]]; then
      _pkg_as_root apk add --no-cache "${without_gcloud[@]}" || return 1
    fi

    if _selected_line_contains_tool_id "$want" "gcloud"; then
      echo "teemill-install: apk: google-cloud-cli install failed; install gcloud from Google docs if needed." >&2
    fi
  fi
}

_install_toolchain_yum() {
  local want="$1"
  local -a base=()

  _selected_line_contains_tool_id "$want" "curl" && base+=(curl)
  _selected_line_contains_tool_id "$want" "git" && base+=(git)

  if [[ "${#base[@]}" -gt 0 ]]; then
    _pkg_as_root yum install -y -q "${base[@]}" || true
  fi

  local -a vendor=()

  _selected_line_contains_tool_id "$want" "gh" && vendor+=(gh)
  _selected_line_contains_tool_id "$want" "gcloud" && vendor+=(google-cloud-cli)
  _selected_line_contains_tool_id "$want" "docker" && vendor+=(docker)
  _selected_line_contains_tool_id "$want" "kubectl" && vendor+=(kubectl)
  _selected_line_contains_tool_id "$want" "helm" && vendor+=(helm)
  _selected_line_contains_tool_id "$want" "terraform" && vendor+=(terraform)

  if [[ "${#vendor[@]}" -gt 0 ]]; then
    if ! _pkg_as_root yum install -y -q "${vendor[@]}" 2>/dev/null; then
      echo "teemill-install: yum: some packages missing in repos; install gh/gcloud/docker/k8s tools from vendor docs if needed." >&2
    fi
  fi
}

_install_toolchain_zypper() {
  local want="$1"
  local -a base=()

  _selected_line_contains_tool_id "$want" "curl" && base+=(curl)
  _selected_line_contains_tool_id "$want" "git" && base+=(git)

  if [[ "${#base[@]}" -gt 0 ]]; then
    _pkg_as_root zypper --non-interactive install -y "${base[@]}" || true
  fi

  local -a extra=()

  _selected_line_contains_tool_id "$want" "gh" && extra+=(gh)
  _selected_line_contains_tool_id "$want" "gcloud" && extra+=(google-cloud-cli)
  _selected_line_contains_tool_id "$want" "docker" && extra+=(docker)
  _selected_line_contains_tool_id "$want" "kubectl" && extra+=(kubectl)
  _selected_line_contains_tool_id "$want" "helm" && extra+=(helm)
  _selected_line_contains_tool_id "$want" "terraform" && extra+=(terraform)

  if [[ "${#extra[@]}" -gt 0 ]]; then
    _pkg_as_root zypper --non-interactive install -y "${extra[@]}" 2>/dev/null || {
      echo "teemill-install: zypper: some optional packages missing; install from vendor docs if needed." >&2
    }
  fi
}

# Linux: add the login user to group "docker" so docker(1) can use the daemon socket without sudo.
# Requires a one-time privileged usermod (same sudo path as package installs). New group membership applies after re-login or: newgrp docker
_teemill_add_login_user_to_docker_group_if_wanted() {
  local want="${1:?}"
  local target_user=""

  [[ "$(uname -s)" == "Linux" ]] || return 0
  _selected_line_contains_tool_id "$want" "docker" || return 0
  getent group docker >/dev/null 2>&1 || {
    echo "teemill-install: docker group not found; skipping usermod (install docker package first)." >&2
    return 0
  }

  target_user="${SUDO_USER:-}"

  if [[ -z "$target_user" ]] && [[ "$(id -u)" -ne 0 ]]; then
    target_user="$(id -un 2>/dev/null || true)"
  fi

  if [[ -z "$target_user" ]] && [[ "$(id -u)" -eq 0 ]]; then
    target_user="$(logname 2>/dev/null || true)"
  fi

  if [[ -z "$target_user" || "$target_user" == "root" ]]; then
    echo "teemill-install: could not determine a non-root login user; add yourself to docker manually: sudo usermod -aG docker \"\$USER\"" >&2
    return 0
  fi

  if id -nG "$target_user" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
    echo "teemill-install: user ${target_user} is already in the docker group." >&2
    return 0
  fi

  _teemill_install_major_step "Docker: add user to docker group (no sudo for docker(1) after re-login)"
  echo "" >&2

  if _pkg_as_root usermod -aG docker "$target_user"; then
    echo "teemill-install: added ${target_user} to group docker — log out and back in, or run: newgrp docker  (then docker commands work without sudo)." >&2
  else
    echo "teemill-install: usermod -aG docker ${target_user} failed; run manually with sudo when you can." >&2
  fi
}

install_toolchain_for_platform() {
  local want="${1:-}"

  if [[ -z "${want// }" ]]; then
    return 0
  fi

  if [[ "$(uname -s)" == "Darwin" ]] && command -v brew >/dev/null 2>&1; then
    _install_toolchain_homebrew "$want"
    return
  fi

  if command -v apt-get >/dev/null 2>&1; then
    _install_toolchain_debian "$want" || return $?
  elif command -v dnf >/dev/null 2>&1; then
    _install_toolchain_dnf "$want" || return $?
  elif command -v yum >/dev/null 2>&1; then
    _install_toolchain_yum "$want" || return $?
  elif command -v zypper >/dev/null 2>&1; then
    _install_toolchain_zypper "$want" || return $?
  elif command -v pacman >/dev/null 2>&1; then
    _install_toolchain_pacman "$want" || return $?
  elif command -v apk >/dev/null 2>&1; then
    _install_toolchain_apk "$want" || return $?
  else
    echo "teemill-install: no supported package manager; install selected tools manually." >&2
    return 1
  fi

  _teemill_add_login_user_to_docker_group_if_wanted "$want"
  return 0
}


_teemill_toggle_version_or_dash() {
  local value="${1:-}"

  value="${value//$'\n'/ }"
  value="${value//[[:space:]]/}"

  if [[ -z "$value" ]]; then
    printf '-'

    return
  fi

  if [[ "${#value}" -gt 14 ]]; then
    printf '%s' "${value:0:14}"

    return
  fi

  printf '%s' "$value"
}

_toolchain_manifest_line_installed() {
  local _root="$1"
  local manifest_line="$2"
  local tool_id

  tool_id="$(manifest_field "$manifest_line" 1)"

  case "$tool_id" in
    curl) command -v curl >/dev/null 2>&1 ;;
    git) command -v git >/dev/null 2>&1 ;;
    gh) command -v gh >/dev/null 2>&1 ;;
    gcloud) command -v gcloud >/dev/null 2>&1 ;;
    docker) command -v docker >/dev/null 2>&1 ;;
    kubectl) command -v kubectl >/dev/null 2>&1 ;;
    helm) command -v helm >/dev/null 2>&1 ;;
    terraform) command -v terraform >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

_teemill_toggle_toolchain_installed_version() {
  local _root="$1"
  local manifest_line="$2"
  local tool_id raw

  tool_id="$(manifest_field "$manifest_line" 1)"

  case "$tool_id" in
    curl) raw="$(_installed_version_curl)" ;;
    git) raw="$(_installed_version_git)" ;;
    gh) raw="$(_installed_version_gh)" ;;
    gcloud) raw="$(_installed_version_gcloud_sdk)" ;;
    docker) raw="$(_installed_version_docker)" ;;
    kubectl) raw="$(_installed_version_kubectl)" ;;
    helm) raw="$(_installed_version_helm)" ;;
    terraform) raw="$(_installed_version_terraform)" ;;
    *) raw="" ;;
  esac

  _teemill_toggle_version_or_dash "$raw"
}

_teemill_toggle_toolchain_target_version() {
  local _root="$1"
  local manifest_line="$2"
  local tool_id raw

  tool_id="$(manifest_field "$manifest_line" 1)"

  case "$tool_id" in
    curl) raw="$(_latest_upstream_curl_tag)" ;;
    git) raw="$(_latest_upstream_git_tag)" ;;
    gh) raw="$(_latest_upstream_gh_tag)" ;;
    gcloud) raw="$(_latest_upstream_gcloud_version)" ;;
    docker) printf 'distro'; return ;;
    kubectl) raw="$(_latest_upstream_kubectl_version)" ;;
    helm) raw="$(_latest_upstream_helm_tag)" ;;
    terraform) raw="$(_latest_upstream_terraform_tag)" ;;
    *) raw="" ;;
  esac

  _teemill_toggle_version_or_dash "$raw"
}


_teemill_toggle_repo_installed_version() {
  local teemill_root="$1"
  local manifest_line="$2"
  local dest rev

  dest="$(manifest_clone_target_path "$teemill_root" "$manifest_line")"

  if [[ ! -d "$dest/.git" ]]; then
    printf '-'

    return
  fi

  rev="$(git -C "$dest" rev-parse --short HEAD 2>/dev/null)"

  _teemill_toggle_version_or_dash "$rev"
}

_teemill_toggle_repo_target_version() {
  local _root="$1"
  local manifest_line="$2"
  local url head

  url="$(manifest_field "$manifest_line" 3)"

  if [[ -z "$url" ]]; then
    printf '-'

    return
  fi

  head="$(GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=5" timeout 10 git ls-remote "$url" HEAD 2>/dev/null | awk '{print substr($1,1,9)}')"

  _teemill_toggle_version_or_dash "$head"
}


_run_gcloud_auth_login_step() {
  local active_account

  if ! command -v gcloud >/dev/null 2>&1; then
    return 0
  fi

  _teemill_install_major_step "Google Cloud: gcloud auth login"
  echo "" >&2

  active_account="$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -n1)"

  if [[ -n "$active_account" ]]; then
    echo "teemill-install: gcloud already has an active account (${active_account}); skipping gcloud auth login." >&2

    return 0
  fi

  if [[ ! -t 1 ]]; then
    echo "teemill-install: stdout is not a terminal; run manually when you can: gcloud auth login" >&2

    return 0
  fi

  if [[ ! -r /dev/tty ]] || [[ ! -w /dev/tty ]]; then
    echo "teemill-install: /dev/tty not available; run manually: gcloud auth login" >&2

    return 0
  fi

  echo "teemill-install: launching gcloud auth login (browser or device flow; stdin from /dev/tty)." >&2

  gcloud auth login </dev/tty || {
    echo "teemill-install: gcloud auth login exited with status $?." >&2
  }
}

# SSH key + ssh-agent (Keychain on macOS), gh git_protocol ssh, gh auth login + setup-git, and optional
# git user.name / user.email from GitHub login + noreply email when those globals are unset.
_configure_git_gh_ssh_and_auth_step() {
  local ssh_dir="$HOME/.ssh"
  local ssh_config="$ssh_dir/config"
  local chosen_private_key=""
  local reply=""
  local gh_authenticated="false"
  local git_name_val=""
  local git_email_val=""
  local api_login=""
  local uname_s=""

  _teemill_install_major_step "Git, GitHub SSH, and gh authentication"
  echo "" >&2

  if ! mkdir -p "$ssh_dir"; then
    echo "teemill-install: could not create $ssh_dir" >&2
    return 0
  fi

  if ! chmod 700 "$ssh_dir"; then
    echo "teemill-install: could not chmod 700 $ssh_dir" >&2
    return 0
  fi

  if [[ -f "$ssh_dir/id_ed25519" ]]; then
    chosen_private_key="$ssh_dir/id_ed25519"
  elif [[ -f "$ssh_dir/id_rsa" ]]; then
    chosen_private_key="$ssh_dir/id_rsa"
  fi

  if [[ -z "$chosen_private_key" ]]; then
    if [[ -t 1 ]] && [[ -r /dev/tty ]] && [[ -w /dev/tty ]]; then
      printf 'teemill-install: generate SSH key at %s/id_ed25519? [Y/n] ' "$ssh_dir" >&2
      read -r reply </dev/tty || reply="n"

      case "${reply,,}" in
        "" | y | yes)
          echo "teemill-install: running ssh-keygen (set a passphrase on the TTY, or leave empty)." >&2

          if ssh-keygen -t ed25519 -f "$ssh_dir/id_ed25519" \
            -C "teemill-install-$(whoami)@$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)" \
            </dev/tty; then
            chosen_private_key="$ssh_dir/id_ed25519"
          else
            echo "teemill-install: ssh-keygen failed or aborted; create a key manually if needed." >&2
          fi
          ;;
        *)
          echo "teemill-install: skipped generating an SSH key." >&2
          ;;
      esac
    else
      echo "teemill-install: no default SSH key ($ssh_dir/id_ed25519 or id_rsa); non-interactive environment." >&2
      echo "teemill-install:   ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -C \"you@example\"" >&2
      echo "teemill-install:   eval \"\$(ssh-agent -s)\"; ssh-add ~/.ssh/id_ed25519" >&2
      echo "teemill-install:   add the .pub key at https://github.com/settings/keys" >&2
    fi
  fi

  if [[ -n "$chosen_private_key" ]]; then
    uname_s="$(uname -s 2>/dev/null || echo "")"

    if [[ "$uname_s" == "Darwin" ]]; then
      if ! ssh-add --apple-use-keychain "$chosen_private_key" 2>/dev/null; then
        ssh-add "$chosen_private_key" 2>/dev/null || {
          echo "teemill-install: ssh-add failed; try: ssh-add --apple-use-keychain $chosen_private_key" >&2
        }
      fi
    else
      if ! ssh-add "$chosen_private_key" 2>/dev/null; then
        echo "teemill-install: ssh-add failed (start an agent: eval \"\$(ssh-agent -s)\" then ssh-add \"$chosen_private_key\")." >&2
      fi

      if [[ -f "$ssh_config" ]]; then
        if grep -qE '^[[:space:]]*Host[[:space:]]+github\.com([[:space:]]|$)' "$ssh_config"; then
          :
        else
          {
            echo ""
            echo "# Added by teemill-install (GitHub SSH defaults)"
            echo "Host github.com"
            echo "  AddKeysToAgent yes"
            echo "  IdentitiesOnly yes"
            echo "  IdentityFile $chosen_private_key"
          } >>"$ssh_config"
          chmod 600 "$ssh_config" 2>/dev/null || true
          echo "teemill-install: appended Host github.com block to $ssh_config" >&2
        fi
      else
        {
          echo "# Added by teemill-install (GitHub SSH defaults)"
          echo "Host github.com"
          echo "  AddKeysToAgent yes"
          echo "  IdentitiesOnly yes"
          echo "  IdentityFile $chosen_private_key"
        } >"$ssh_config"
        chmod 600 "$ssh_config" 2>/dev/null || true
        echo "teemill-install: created $ssh_config with Host github.com defaults" >&2
      fi
    fi

    if [[ -f "${chosen_private_key}.pub" ]]; then
      echo "teemill-install: add this public key to GitHub if needed: https://github.com/settings/keys" >&2
      echo "teemill-install: ----" >&2
      cat "${chosen_private_key}.pub" >&2
      echo "teemill-install: ----" >&2
    fi
  fi

  if gh config set -h github.com git_protocol ssh 2>/dev/null; then
    :
  elif gh config set git_protocol ssh 2>/dev/null; then
    echo "teemill-install: set gh git_protocol ssh globally (no per-host flag on this gh version)." >&2
  else
    echo "teemill-install: could not set gh git_protocol ssh; try: gh config set -h github.com git_protocol ssh" >&2
  fi

  if gh auth status -h github.com >/dev/null 2>&1; then
    gh_authenticated="true"
  else
    if gh auth status 2>&1 | grep -qi 'Logged in to github.com'; then
      gh_authenticated="true"
    fi
  fi

  if [[ "$gh_authenticated" == "true" ]]; then
    echo "teemill-install: gh is already logged in to github.com." >&2
  else
    if [[ -t 1 ]] && [[ -r /dev/tty ]] && [[ -w /dev/tty ]]; then
      echo "teemill-install: launching gh auth login (github.com, SSH, web; stdin from /dev/tty)." >&2

      if gh auth login -h github.com --git-protocol ssh --web </dev/tty; then
        gh_authenticated="true"
      else
        echo "teemill-install: gh auth login failed; run: gh auth login -h github.com --git-protocol ssh --web" >&2
      fi
    else
      echo "teemill-install: not interactive; run: gh auth login -h github.com --git-protocol ssh --web" >&2
    fi
  fi

  if [[ "$gh_authenticated" == "true" ]]; then
    if gh auth setup-git -h github.com >/dev/null 2>&1; then
      :
    elif gh auth setup-git >/dev/null 2>&1; then
      :
    else
      echo "teemill-install: gh auth setup-git failed or is unsupported on this gh version." >&2
    fi

    # If user.name / user.email are unset, use GitHub login and GitHub noreply (private email on commits).
    git_name_val="$(git config --global --get user.name 2>/dev/null || true)"
    git_email_val="$(git config --global --get user.email 2>/dev/null || true)"

    if [[ -z "$git_name_val" ]] || [[ -z "$git_email_val" ]]; then
      api_login="$(GH_HOST=github.com gh api user -q .login 2>/dev/null || true)"

      if [[ -n "$api_login" ]]; then
        if [[ -z "$git_name_val" ]]; then
          git config --global user.name "$api_login" || true
        fi

        if [[ -z "$git_email_val" ]]; then
          git config --global user.email "${api_login}@users.noreply.github.com" || true
        fi

        echo "teemill-install: set missing git user.name / user.email from GitHub (${api_login}@users.noreply.github.com)." >&2
      fi
    fi
  fi
}

# True when /etc/os-release declares ID=ubuntu (not derivatives unless ID is exactly ubuntu).
_teemill_os_release_id_is_ubuntu_strict() {
  local os_id=""

  [[ -r /etc/os-release ]] || return 1
  os_id="$(grep -E '^[[:space:]]*ID=' /etc/os-release 2>/dev/null | head -n1 | cut -d= -f2- | tr -d '"' | tr -d "'")"
  os_id="${os_id#"${os_id%%[![:space:]]*}"}"
  os_id="${os_id%"${os_id##*[![:space:]]}"}"
  [[ "$os_id" == "ubuntu" ]]
}

_teemill_desktop_basename_is_installed() {
  local base="$1"
  local candidate_path=""

  for candidate_path in \
    "/usr/share/applications/${base}" \
    "${HOME}/.local/share/applications/${base}" \
    "/var/lib/snapd/desktop/applications/${base}" \
    "/usr/local/share/applications/${base}"; do
    if [[ -f "$candidate_path" ]]; then
      return 0
    fi
  done

  return 1
}

# Prints a gsettings-compatible desktop-id array string, e.g. ['a.desktop', 'b.desktop'].
_teemill_gvariant_favorite_apps_array() {
  local out="["
  local first=1
  local item=""

  for item in "$@"; do
    [[ -z "$item" ]] && continue

    if [[ "$first" -eq 1 ]]; then
      first=0
    else
      out+=", "
    fi

    out+="'${item}'"
  done

  out+="]"
  printf '%s' "$out"
}

_teemill_resolve_default_browser_desktop_basename() {
  local candidate=""
  local fallback=""

  if command -v xdg-mime >/dev/null 2>&1; then
    candidate="$(xdg-mime query default x-scheme-handler/http 2>/dev/null || true)"
    candidate="${candidate#"${candidate%%[![:space:]]*}"}"
    candidate="${candidate%"${candidate##*[![:space:]]}"}"

    if [[ -n "$candidate" ]] && _teemill_desktop_basename_is_installed "$candidate"; then
      printf '%s' "$candidate"
      return 0
    fi
  fi

  if command -v xdg-settings >/dev/null 2>&1; then
    candidate="$(xdg-settings get default-web-browser 2>/dev/null || true)"
    candidate="${candidate#"${candidate%%[![:space:]]*}"}"
    candidate="${candidate%"${candidate##*[![:space:]]}"}"

    if [[ -n "$candidate" ]] && _teemill_desktop_basename_is_installed "$candidate"; then
      printf '%s' "$candidate"
      return 0
    fi
  fi

  for fallback in firefox.desktop google-chrome.desktop chromium-browser.desktop chromium.desktop; do
    if _teemill_desktop_basename_is_installed "$fallback"; then
      printf '%s' "$fallback"
      return 0
    fi
  done

  printf ''
}

_teemill_resolve_primary_ide_desktop_basename() {
  local ide_choice="${1:-skip}"
  local fallback=""

  case "$ide_choice" in
    cursor)
      if _teemill_desktop_basename_is_installed "cursor.desktop"; then
        printf '%s' "cursor.desktop"
        return 0
      fi

      echo "teemill-install: warning: cursor.desktop not found; trying other IDE .desktop files for dock." >&2
      ;;
    jetbrains-toolbox)
      if _teemill_desktop_basename_is_installed "jetbrains-toolbox.desktop"; then
        printf '%s' "jetbrains-toolbox.desktop"
        return 0
      fi

      echo "teemill-install: warning: jetbrains-toolbox.desktop not found; trying other IDE .desktop files for dock." >&2
      ;;
    skip)
      echo "teemill-install: note: picking first available IDE .desktop for dock (no IDE install step)." >&2
      ;;
    *)
      echo "teemill-install: warning: unknown IDE id '${ide_choice}'; picking first available IDE .desktop for dock." >&2
      ;;
  esac

  for fallback in cursor.desktop jetbrains-toolbox.desktop; do
    if _teemill_desktop_basename_is_installed "$fallback"; then
      printf '%s' "$fallback"
      return 0
    fi
  done

  printf ''
}

_teemill_resolve_terminal_desktop_basename() {
  local fallback=""

  for fallback in org.gnome.Terminal.desktop gnome-terminal.desktop; do
    if _teemill_desktop_basename_is_installed "$fallback"; then
      printf '%s' "$fallback"
      return 0
    fi
  done

  for fallback in konsole.desktop; do
    if _teemill_desktop_basename_is_installed "$fallback"; then
      printf '%s' "$fallback"
      return 0
    fi
  done

  printf ''
}


_teemill_ubuntu_gnome_favorites_can_use_gsettings() {
  command -v gsettings >/dev/null 2>&1 || return 1
  gsettings get org.gnome.shell favorite-apps >/dev/null 2>&1
}

# Ubuntu + GNOME Shell only: replace favorite-apps with browser, IDE, terminal when resolvable.
# ide_choice: cursor | jetbrains-toolbox | skip (skip picks the first installed IDE .desktop for the dock).
bootstrap_ubuntu_gnome_favorite_apps() {
  local ide_choice="${1:-skip}"
  local browser_desktop=""
  local ide_desktop=""
  local terminal_desktop=""
  local gvariant=""
  local resolved_count=0
  local -a favorites_list=()

  if ! _teemill_os_release_id_is_ubuntu_strict; then
    if [[ "${TEEMILL_DEBUG:-}" == "1" ]]; then
      echo "teemill-install: debug: skipping Ubuntu GNOME favorites (not ID=ubuntu)." >&2
    fi

    return 0
  fi

  if ! command -v gsettings >/dev/null 2>&1; then
    echo "teemill-install: Ubuntu: skipping dock favorites (gsettings not installed). Manual: gsettings set org.gnome.shell favorite-apps \"['firefox.desktop','cursor.desktop','org.gnome.Terminal.desktop']\" (adjust .desktop basenames)." >&2

    return 0
  fi

  if ! _teemill_ubuntu_gnome_favorites_can_use_gsettings; then
    echo "teemill-install: Ubuntu: skipping dock favorites (gsettings cannot read org.gnome.shell; need GNOME Shell and a usable session D-Bus). Settings > Ubuntu Desktop > Dock, or: gsettings set org.gnome.shell favorite-apps \"[...]\". Over SSH, export DBUS_SESSION_BUS_ADDRESS from your graphical login, or run this from a terminal on the machine." >&2

    if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" && -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
      echo "teemill-install: Ubuntu: DISPLAY, WAYLAND_DISPLAY, and DBUS_SESSION_BUS_ADDRESS are unset." >&2
    fi

    return 0
  fi

  _teemill_install_major_step "Ubuntu GNOME: dock favorites"
  echo "" >&2

  browser_desktop="$(_teemill_resolve_default_browser_desktop_basename)"
  ide_desktop="$(_teemill_resolve_primary_ide_desktop_basename "$ide_choice")"
  terminal_desktop="$(_teemill_resolve_terminal_desktop_basename)"

  [[ -n "$browser_desktop" ]] && resolved_count=$((resolved_count + 1))
  [[ -n "$ide_desktop" ]] && resolved_count=$((resolved_count + 1))
  [[ -n "$terminal_desktop" ]] && resolved_count=$((resolved_count + 1))

  if [[ -z "$browser_desktop" ]]; then
    echo "teemill-install: warning: could not resolve default browser .desktop for dock favorites." >&2
  fi

  if [[ -z "$ide_desktop" ]]; then
    echo "teemill-install: warning: could not resolve IDE .desktop for dock favorites." >&2
  fi

  if [[ -z "$terminal_desktop" ]]; then
    echo "teemill-install: warning: could not resolve terminal .desktop for dock favorites." >&2
  fi

  if [[ "$resolved_count" -lt 2 ]]; then
    echo "teemill-install: Ubuntu: not changing dock favorites (need at least two resolved .desktop entries; got ${resolved_count})." >&2

    return 0
  fi

  if [[ "$resolved_count" -lt 3 ]]; then
    echo "teemill-install: warning: applying partial dock favorites (${resolved_count}/3 .desktop entries resolved)." >&2
  fi

  if [[ -n "$browser_desktop" ]]; then
    favorites_list+=("$browser_desktop")
  fi

  if [[ -n "$ide_desktop" ]]; then
    favorites_list+=("$ide_desktop")
  fi

  if [[ -n "$terminal_desktop" ]]; then
    favorites_list+=("$terminal_desktop")
  fi

  gvariant="$(_teemill_gvariant_favorite_apps_array "${favorites_list[@]}")"

  if ! gsettings set org.gnome.shell favorite-apps "$gvariant"; then
    echo "teemill-install: Ubuntu: gsettings set org.gnome.shell favorite-apps failed; configure the dock manually." >&2

    return 0
  fi

  echo "teemill-install: Ubuntu GNOME Shell dock favorites set to: ${favorites_list[*]}" >&2
}

# Creates workspace root, optional toolchain (multi-select), then auth steps.
# Pass dry_run true to print toolchain package plans without mutating (except mkdir workspace root).
# selected_tools_line empty skips toolchain install and version summary.
bootstrap_environment() {
  local workspace_root="$1"
  local assume_yes="${2:-false}"
  local dry_run="${3:-false}"
  local selected_tools_line="${4:-}"

  mkdir -p "$workspace_root" || {
    echo "teemill-install: could not create directory: $workspace_root" >&2
    exit 2
  }

  if [[ -z "${selected_tools_line// }" ]]; then
    _teemill_install_major_step "Toolchain: skipped (nothing selected)"
    echo "" >&2
    echo "teemill-install: no toolchain packages selected; skipping toolchain install and version summary." >&2

    if [[ "$dry_run" != "true" ]]; then
      _run_gcloud_auth_login_step
    fi

    _configure_git_gh_ssh_and_auth_step

    _teemill_install_major_step "Next: clone Teemill repositories over SSH"
    echo "" >&2
    echo "teemill-install: clones use SSH (git@github.com:Teemill/…). Ensure your GitHub SSH key is loaded." >&2

    return 0
  fi

  _print_selected_toolchain_version_summary "$selected_tools_line" "$assume_yes"

  if [[ "$dry_run" == "true" ]]; then
    _print_toolchain_dry_run_package_plan "$selected_tools_line"

    _configure_git_gh_ssh_and_auth_step

    _teemill_install_major_step "Next: clone Teemill repositories over SSH"
    echo "" >&2
    echo "teemill-install: clones use SSH (git@github.com:Teemill/…). Ensure your GitHub SSH key is loaded." >&2

    return 0
  fi

  _teemill_install_major_step "Toolchain: installing packages"
  echo "" >&2

  if ! install_toolchain_for_platform "$selected_tools_line"; then
    exit 2
  fi

  if _selected_line_contains_tool_id "$selected_tools_line" "curl" && ! command -v curl >/dev/null 2>&1; then
    echo "teemill-install: curl is still not on PATH after install attempt." >&2
    exit 2
  fi

  if _selected_line_contains_tool_id "$selected_tools_line" "git" && ! command -v git >/dev/null 2>&1; then
    echo "teemill-install: git is still not on PATH after install attempt." >&2
    exit 2
  fi

  if _selected_line_contains_tool_id "$selected_tools_line" "gh" && ! command -v gh >/dev/null 2>&1; then
    echo "teemill-install: gh is still not on PATH after install attempt." >&2
    exit 2
  fi

  if _selected_line_contains_tool_id "$selected_tools_line" "gcloud" && ! command -v gcloud >/dev/null 2>&1; then
    echo "teemill-install: gcloud is still not on PATH after install attempt." >&2
    exit 2
  fi

  if _selected_line_contains_tool_id "$selected_tools_line" "docker" && ! command -v docker >/dev/null 2>&1; then
    echo "teemill-install: docker is still not on PATH after install attempt." >&2
    exit 2
  fi

  if _selected_line_contains_tool_id "$selected_tools_line" "kubectl" && ! command -v kubectl >/dev/null 2>&1; then
    echo "teemill-install: kubectl is still not on PATH after install attempt." >&2
    exit 2
  fi

  if _selected_line_contains_tool_id "$selected_tools_line" "helm" && ! command -v helm >/dev/null 2>&1; then
    echo "teemill-install: helm is still not on PATH after install attempt." >&2
    exit 2
  fi

  if _selected_line_contains_tool_id "$selected_tools_line" "terraform" && ! command -v terraform >/dev/null 2>&1; then
    echo "teemill-install: terraform is still not on PATH after install attempt." >&2
    exit 2
  fi

  _run_gcloud_auth_login_step

  _configure_git_gh_ssh_and_auth_step

  _teemill_install_major_step "Next: clone Teemill repositories over SSH"
  echo "" >&2
  echo "teemill-install: clones use SSH (git@github.com:Teemill/…). Ensure your GitHub SSH key is loaded." >&2
}

# Repositories offered. Format:
#   id|description|clone_url|target_directory
# If target_directory is empty, it defaults to id.
readonly REPO_MANIFEST='
core-api|Core API (backend)|git@github.com:Teemill/core-api.git|
frontend|Frontend|git@github.com:Teemill/frontend.git|
frontend-legacy|Frontend (legacy tree; same remote as frontend)|git@github.com:Teemill/frontend.git|frontend-legacy
image-api|Image API|git@github.com:Teemill/image-api.git|
enforcer|Enforcer|git@github.com:Teemill/enforcer.git|
drive|Drive|git@github.com:Teemill/drive.git|
file-processor|File processor|git@github.com:Teemill/file-processor.git|
domain-manager|Domains (domain-manager)|git@github.com:Teemill/domain-manager.git|
metrics|Metrics|git@github.com:Teemill/metrics.git|
product-feed|Product feed|git@github.com:Teemill/product-feed.git|
infrastructure|Infrastructure|git@github.com:Teemill/infrastructure.git|
'

# Space-separated repo ids chosen when you press Enter at the prompt.
readonly DEFAULT_SELECTED_IDS="core-api frontend image-api"

# Toolchain packages (id|description). Defaults: curl git gh gcloud docker; optional off by default: kubectl helm terraform.
readonly TOOL_MANIFEST='
curl|curl (HTTP client)|
git|git (version control)|
gh|GitHub CLI (gh)|
gcloud|Google Cloud SDK (gcloud)|
docker|Docker (distro engine; user in docker group = no sudo for docker(1))|
kubectl|kubectl (Kubernetes CLI)|
helm|Helm (Kubernetes package manager)|
terraform|Terraform (IaC)|
'

readonly DEFAULT_SELECTED_TOOL_IDS="curl git gh gcloud docker"

usage() {
  cat <<'EOF'
Usage: install [options]
  (local file: bash path/to/install   remote: curl ... | bash -s -- [options])

  Clones Teemill repos into ~/teemill (created if missing). First pick toolchain packages (defaults:
  curl, git, gh, gcloud, docker; optional: kubectl, helm, terraform) using the same arrow/Space menu as
  repos (numbered fallback without a TTY). Toolchain and repo pickers show [✓] when already present
  and two columns (installed -> target, best effort). A version summary is shown only for selected tools, then
  packages are installed. Use --yes for non-interactive runs: default toolchain selection and default repo clone set
  without prompts.

  When gcloud is on PATH, runs gcloud auth login when there is no active gcloud account and a terminal is
  available (otherwise prints a reminder to run it manually). Skipped under --dry-run.

  Then configures GitHub over SSH for git/gh: default SSH key (or optional interactive
  ssh-keygen), ssh-add / macOS Keychain, Linux ~/.ssh/config Host github.com hints, gh
  git_protocol ssh, gh auth login + setup-git when needed, and git user.name / user.email
  from your GitHub login when unset (noreply email).

  On Ubuntu (ID=ubuntu) with GNOME Shell, may reset the dock to default browser + first detected IDE +
  terminal via gsettings (org.gnome.shell favorite-apps) when those .desktop entries resolve.

  Clones use SSH (git@github.com:Teemill/…). The frontend and frontend-legacy ids use
  git clone --filter=blob:none. Ensure GitHub SSH auth works.

  Arrow keys + Space to pick repos (Enter confirms). If there is no TTY, you type
  numbers instead (see prompt on screen).

Remote (curl | bash):
  curl -fsSL <raw-url-to-this-script> | bash -s -- --yes

Options:
  --root DIR     Clone destination (default: ~/teemill or $TEEMILL_ROOT)
  --yes, -y      Non-interactive: default toolchain ids and default repo clone set
  --dry-run      Print selected toolchain package plan and git clone commands (no installs)
  --list         Print known repositories and exit
  -h, --help     Show this help

Environment:
  TEEMILL_ROOT   Same as --root when --root is omitted
  TEEMILL_DEBUG  Set to 1 for extra stderr when Ubuntu dock favorites are skipped

Dependencies:
  sudo on Linux when not root (package installs and adding your user to the docker group). Upstream version checks use curl when present, otherwise wget.
  Docker on Linux is the distro docker.io / docker package; the script adds your login user to the docker group so docker(1) can use the socket without sudo after you re-login or run newgrp docker. macOS uses brew install docker when Homebrew is available.
  After toolchain install (or if gcloud is already on PATH), gcloud auth login when appropriate, then git/gh + GitHub SSH + gh auth when a TTY allows it.
EOF
}

arrow_menu_tty_available() {
  exec 3<>/dev/tty 2>/dev/null && [[ -t 3 ]] && exec 3<&- && exec 3>&-
}

is_id_in_default_list() {
  local default_space_list="$1"
  local candidate="$2"
  local token

  for token in $default_space_list; do
    if [[ "$token" == "$candidate" ]]; then
      return 0
    fi
  done

  return 1
}

is_selected_by_default() {
  is_id_in_default_list "$DEFAULT_SELECTED_IDS" "$1"
}

# Reads one logical key from fd 3. Prints a token: UP DOWN ENTER SPACE ESC Q NONE
# Uses read -N1 (not -n1): Enter sends LF/CR and must be read as data, not as read's line delimiter.
read_menu_key() {
  local tty_fd="$1"
  local first second third

  IFS= read -rsN1 -u "$tty_fd" first || return 1

  if [[ -z "$first" ]]; then
    printf 'ENTER'
    return
  fi

  if [[ "$first" == $'\e' ]]; then
    if ! IFS= read -rsN1 -t 0.05 -u "$tty_fd" second; then
      printf 'ESC'
      return
    fi

    if [[ "$second" == "[" || "$second" == "O" ]]; then
      if ! IFS= read -rsN1 -t 0.05 -u "$tty_fd" third; then
        printf 'NONE'
        return
      fi

      if [[ "$second" == "[" ]]; then
        case "$third" in
          A) printf 'UP' ;;
          B) printf 'DOWN' ;;
          *) printf 'NONE' ;;
        esac

        return
      fi

      if [[ "$second" == "O" ]]; then
        case "$third" in
          A) printf 'UP' ;;
          B) printf 'DOWN' ;;
          *) printf 'NONE' ;;
        esac

        return
      fi
    fi

    printf 'NONE'
    return
  fi

  if [[ "$first" == " " ]]; then
    printf 'SPACE'
    return
  fi

  if [[ "$first" == $'\n' || "$first" == $'\r' ]]; then
    printf 'ENTER'
    return
  fi

  if [[ "$first" == "q" || "$first" == "Q" ]]; then
    printf 'Q'
    return
  fi

  printf 'NONE'
}

# Same TTY UX as repos; shows on-PATH tools with [✓] and installed vs upstream columns.
run_tool_arrow_menu() {
  local menu_status=0

  TEEMILL_TOGGLE_VERSION_INSTALLED_FN=_teemill_toggle_toolchain_installed_version
  TEEMILL_TOGGLE_VERSION_TARGET_FN=_teemill_toggle_toolchain_target_version

  run_toggle_arrow_menu \
    "Toolchain packages  (install / upgrade)" \
    $'  [✓] = already on PATH  |  columns: installed -> target (upstream / distro; best effort)\n  ↑/↓ move (rows not yet on PATH)   Space toggle   Enter confirm   q quit' \
    "" \
    _toolchain_manifest_line_installed \
    "$DEFAULT_SELECTED_TOOL_IDS" \
    "$@" || menu_status=$?

  unset TEEMILL_TOGGLE_VERSION_INSTALLED_FN TEEMILL_TOGGLE_VERSION_TARGET_FN

  return "$menu_status"
}

# Draws on fd 3; prints selected manifest ids (field 1) to stdout (one per line) on Enter.
run_toggle_arrow_menu() {
  local menu_title_line="$1"
  local menu_hint_line="$2"
  local root_for_installed="$3"
  local installed_check_fn="$4"
  local default_ids_string="$5"
  shift 5
  local -a manifest_lines=("$@")
  local count="${#manifest_lines[@]}"
  local tty_fd=3
  local saved_stty=""
  local -a selected=()
  local -a installed=()
  local -a version_installed_col=()
  local -a version_target_col=()
  local -a selectable_pos=()
  local sel_n=0
  local sel_ix=0
  local cursor=-1
  local index

  if [[ -n "$root_for_installed" ]] && [[ -d "$root_for_installed" ]]; then
    root_for_installed="$(cd -- "$root_for_installed" && pwd)"
  fi

  exec 3<>/dev/tty || return 2

  if ! [[ -t 3 ]]; then
    exec 3<&-
    exec 3>&-

    return 2
  fi

  saved_stty="$(stty -g <&3)"
  local menu_cleaned=0

  cleanup_arrow_menu() {
    if [[ "$menu_cleaned" -eq 1 ]]; then
      return 0
    fi

    menu_cleaned=1
    printf '\e[?25h' >&3 2>/dev/null || true

    if [[ -n "${saved_stty:-}" ]]; then
      stty "$saved_stty" <&3 2>/dev/null || true
    fi

    exec 3<&-
    exec 3>&-
  }

  trap 'trap - EXIT; cleanup_arrow_menu; trap - INT; exit 130' INT
  trap 'cleanup_arrow_menu' EXIT

  stty -echo -icanon min 1 time 0 <&3

  local manifest_line display_id

  for ((index = 0; index < count; index++)); do
    manifest_line="${manifest_lines[index]}"
    display_id="$(manifest_field "$manifest_line" 1)"

    if "$installed_check_fn" "$root_for_installed" "$manifest_line"; then
      installed[index]=1
      selected[index]=0
    else
      installed[index]=0
      selectable_pos+=("$index")

      if is_id_in_default_list "$default_ids_string" "$display_id"; then
        selected[index]=1
      else
        selected[index]=0
      fi
    fi
  done

  if [[ -n "${TEEMILL_TOGGLE_VERSION_INSTALLED_FN:-}" || -n "${TEEMILL_TOGGLE_VERSION_TARGET_FN:-}" ]]; then
    local vi vt

    for ((index = 0; index < count; index++)); do
      manifest_line="${manifest_lines[index]}"
      vi="-"
      vt="-"

      if [[ -n "${TEEMILL_TOGGLE_VERSION_INSTALLED_FN:-}" ]]; then
        vi="$("$TEEMILL_TOGGLE_VERSION_INSTALLED_FN" "$root_for_installed" "$manifest_line")"
        [[ -z "${vi// }" ]] && vi="-"
      fi

      if [[ -n "${TEEMILL_TOGGLE_VERSION_TARGET_FN:-}" ]]; then
        vt="$("$TEEMILL_TOGGLE_VERSION_TARGET_FN" "$root_for_installed" "$manifest_line")"
        [[ -z "${vt// }" ]] && vt="-"
      fi

      version_installed_col[index]="${vi:0:14}"
      version_target_col[index]="${vt:0:14}"
    done
  fi

  sel_n="${#selectable_pos[@]}"

  if [[ "$sel_n" -gt 0 ]]; then
    sel_ix=0
    cursor="${selectable_pos[0]}"
  fi

  # Screen lines before the first repo row (title, blank, hint, blank).
  local -r menu_screen_header_lines=3

  draw_menu_row() {
    local row_index="$1"
    local with_cursor_highlight="$2"
    local screen_line=$((menu_screen_header_lines + 1 + row_index))
    local manifest_line display_id description row_mark
    local vi="-"
    local vt="-"

    manifest_line="${manifest_lines[row_index]}"
    display_id="$(manifest_field "$manifest_line" 1)"
    description="$(manifest_field "$manifest_line" 2)"

    if [[ -n "${TEEMILL_TOGGLE_VERSION_INSTALLED_FN:-}" || -n "${TEEMILL_TOGGLE_VERSION_TARGET_FN:-}" ]]; then
      vi="${version_installed_col[row_index]:--}"
      vt="${version_target_col[row_index]:--}"
    fi

    printf '\e[%d;1H\e[K' "$screen_line" >&3

    if [[ -n "${TEEMILL_TOGGLE_VERSION_INSTALLED_FN:-}" || -n "${TEEMILL_TOGGLE_VERSION_TARGET_FN:-}" ]]; then
      if [[ "${installed[row_index]:-0}" -eq 1 ]]; then
        printf '  \e[32m%s  %-14s  %-14s  %-14s  %s\e[0m' '[✓]' "$display_id" "$vi" "$vt" "$description" >&3

        return
      fi

      row_mark="[ ]"

      if [[ "${selected[row_index]:-0}" -eq 1 ]]; then
        row_mark="[x]"
      fi

      if [[ "$with_cursor_highlight" -eq 1 ]]; then
        printf '  \e[7m%s  %-14s  %-14s  %-14s  %s\e[0m' "$row_mark" "$display_id" "$vi" "$vt" "$description" >&3
      else
        printf '  %s  %-14s  %-14s  %-14s  %s' "$row_mark" "$display_id" "$vi" "$vt" "$description" >&3
      fi

      return
    fi

    if [[ "${installed[row_index]:-0}" -eq 1 ]]; then
      printf '  \e[32m%s  %-18s  %s\e[0m' '[✓]' "$display_id" "$description" >&3

      return
    fi

    row_mark="[ ]"

    if [[ "${selected[row_index]:-0}" -eq 1 ]]; then
      row_mark="[x]"
    fi

    if [[ "$with_cursor_highlight" -eq 1 ]]; then
      printf '  \e[7m%s  %-18s  %s\e[0m' "$row_mark" "$display_id" "$description" >&3
    else
      printf '  %s  %-18s  %s' "$row_mark" "$display_id" "$description" >&3
    fi
  }

  local first_menu_draw=1
  local old_cursor=0
  local redraw_key

  while true; do
    if [[ "$first_menu_draw" -eq 1 ]]; then
      printf '\e[2J\e[H\e[?25l' >&3
      printf '%s\n' "$menu_title_line" >&3
      echo >&3
      printf '%s\n' "$menu_hint_line" >&3

      for ((index = 0; index < count; index++)); do
        if [[ "$sel_n" -gt 0 && "$index" -eq "$cursor" ]]; then
          draw_menu_row "$index" 1
        else
          draw_menu_row "$index" 0
        fi
      done

      first_menu_draw=0
    fi

    redraw_key="$(read_menu_key "$tty_fd")"
    old_cursor="$cursor"

    case "$redraw_key" in
      UP)
        if [[ "$sel_n" -eq 0 ]]; then
          :
        else
          sel_ix=$(( (sel_ix - 1 + sel_n) % sel_n ))
          cursor="${selectable_pos[$sel_ix]}"
          draw_menu_row "$old_cursor" 0
          draw_menu_row "$cursor" 1
        fi
        ;;
      DOWN)
        if [[ "$sel_n" -eq 0 ]]; then
          :
        else
          sel_ix=$(( (sel_ix + 1) % sel_n ))
          cursor="${selectable_pos[$sel_ix]}"
          draw_menu_row "$old_cursor" 0
          draw_menu_row "$cursor" 1
        fi
        ;;
      SPACE)
        if [[ "$sel_n" -eq 0 ]]; then
          :
        elif [[ "${installed[cursor]:-0}" -eq 1 ]]; then
          :
        else
          if [[ "${selected[cursor]:-0}" -eq 1 ]]; then
            selected[cursor]=0
          else
            selected[cursor]=1
          fi

          draw_menu_row "$cursor" 1
        fi
        ;;
      ENTER)
        trap - EXIT
        trap - INT
        cleanup_arrow_menu

        for ((index = 0; index < count; index++)); do
          if [[ "${installed[index]:-0}" -eq 1 ]]; then
            continue
          fi

          if [[ "${selected[index]:-0}" -eq 1 ]]; then
            manifest_line="${manifest_lines[index]}"
            manifest_field "$manifest_line" 1
          fi
        done

        return 0
        ;;
      ESC | Q)
        trap - EXIT
        trap - INT
        cleanup_arrow_menu

        return 0
        ;;
      *)
        ;;
    esac
  done
}

run_repo_arrow_menu() {
  local teemill_root="$1"
  local menu_status=0
  shift
  local -a manifest_lines=("$@")

  if [[ -d "$teemill_root" ]]; then
    teemill_root="$(cd -- "$teemill_root" && pwd)"
  fi

  TEEMILL_TOGGLE_VERSION_INSTALLED_FN=_teemill_toggle_repo_installed_version
  TEEMILL_TOGGLE_VERSION_TARGET_FN=_teemill_toggle_repo_target_version

  run_toggle_arrow_menu \
    "Teemill repositories  (clone into: $teemill_root)" \
    $'  [✓] = already cloned  |  columns: local HEAD -> remote HEAD (best effort; needs SSH to GitHub)\n  ↑/↓ move (repos to clone only)   Space toggle   Enter confirm   q quit' \
    "$teemill_root" \
    is_manifest_repo_installed \
    "$DEFAULT_SELECTED_IDS" \
    "${manifest_lines[@]}" || menu_status=$?

  unset TEEMILL_TOGGLE_VERSION_INSTALLED_FN TEEMILL_TOGGLE_VERSION_TARGET_FN

  return "$menu_status"
}

# HEREDOC-style manifest blocks: drop blank lines and #-comments.
_teemill_manifest_non_comment_lines_from() {
  local raw="${1:?}"

  grep -v '^[[:space:]]*$' <<<"$raw" | grep -v '^[[:space:]]*#'
}

parse_manifest_lines() {
  _teemill_manifest_non_comment_lines_from "$REPO_MANIFEST"
}

parse_tool_manifest_lines() {
  _teemill_manifest_non_comment_lines_from "$TOOL_MANIFEST"
}

manifest_field() {
  local line="$1"
  local index="$2"
  echo "$line" | awk -F'|' -v "idx=$index" '{gsub(/^[ \t]+|[ \t]+$/,"",$idx); print $idx}'
}

# Clone destination directory for a manifest row (absolute teemill_root recommended).
manifest_clone_target_path() {
  local teemill_root="$1"
  local manifest_line="$2"
  local id target_dir

  id="$(manifest_field "$manifest_line" 1)"
  target_dir="$(manifest_field "$manifest_line" 4)"
  [[ -z "$target_dir" ]] && target_dir="$id"
  printf '%s/%s' "$teemill_root" "$target_dir"
}

is_manifest_repo_installed() {
  local dest_path
  dest_path="$(manifest_clone_target_path "$1" "$2")"
  [[ -d "$dest_path/.git" ]]
}

# Prints one repo id per line to stdout. Uses arrow/Space on /dev/tty when available.
prompt_repo_ids_cli() {
  local teemill_root="$1"
  local -a manifest_lines=()
  local manifest_line

  while IFS= read -r manifest_line; do
    [[ -z "$manifest_line" ]] && continue
    manifest_lines+=("$manifest_line")
  done < <(parse_manifest_lines)

  if [[ "${#manifest_lines[@]}" -eq 0 ]]; then
    echo "teemill-install: internal error: empty manifest." >&2
    exit 2
  fi

  if [[ -d "$teemill_root" ]]; then
    teemill_root="$(cd -- "$teemill_root" && pwd)"
  fi

  if arrow_menu_tty_available; then
    local menu_status=0
    run_repo_arrow_menu "$teemill_root" "${manifest_lines[@]}" || menu_status=$?

    if [[ "$menu_status" -eq 2 ]]; then
      prompt_repo_ids_fallback_numbers "$teemill_root" "${manifest_lines[@]}"
    fi

    return
  fi

  prompt_repo_ids_fallback_numbers "$teemill_root" "${manifest_lines[@]}"
}

# Plain line-based multi-select when there is no usable TTY for the arrow menu.
# installed_check_fn is invoked as: fn root_for_installed manifest_line
prompt_toggle_ids_fallback_numbers() {
  local root_for_installed="$1"
  local title_line="$2"
  local installed_check_fn="$3"
  local default_ids_string="$4"
  local footer_default_hint="$5"
  local footer_installed_hint="$6"
  local prompt_label="$7"
  shift 7
  local -a manifest_lines=("$@")
  local count="${#manifest_lines[@]}"
  local index display_id description marker
  local reply normalized token start end i j
  local manifest_line
  local -a row_installed=()
  local vi vt

  if [[ -n "$root_for_installed" ]] && [[ -d "$root_for_installed" ]]; then
    root_for_installed="$(cd -- "$root_for_installed" && pwd)"
  fi

  for ((index = 0; index < count; index++)); do
    manifest_line="${manifest_lines[index]}"

    if "$installed_check_fn" "$root_for_installed" "$manifest_line"; then
      row_installed[index]=1
    else
      row_installed[index]=0
    fi
  done

  _teemill_install_major_step "Numbered multi-select (no arrow-menu TTY)"
  echo "" >&2
  printf '%s\n' "$title_line" >&2
  echo >&2

  if [[ -n "${TEEMILL_TOGGLE_VERSION_INSTALLED_FN:-}" || -n "${TEEMILL_TOGGLE_VERSION_TARGET_FN:-}" ]]; then
    echo "  Legend: installed -> target (best effort)." >&2
    echo >&2
  fi

  index=1

  for ((j = 0; j < count; j++)); do
    manifest_line="${manifest_lines[j]}"
    display_id="$(manifest_field "$manifest_line" 1)"
    description="$(manifest_field "$manifest_line" 2)"
    marker=" "
    vi="-"
    vt="-"

    if [[ -n "${TEEMILL_TOGGLE_VERSION_INSTALLED_FN:-}" ]]; then
      vi="$("$TEEMILL_TOGGLE_VERSION_INSTALLED_FN" "$root_for_installed" "$manifest_line")"
      [[ -z "${vi// }" ]] && vi="-"
    fi

    if [[ -n "${TEEMILL_TOGGLE_VERSION_TARGET_FN:-}" ]]; then
      vt="$("$TEEMILL_TOGGLE_VERSION_TARGET_FN" "$root_for_installed" "$manifest_line")"
      [[ -z "${vt// }" ]] && vt="-"
    fi

    vi="${vi:0:14}"
    vt="${vt:0:14}"

    if [[ -n "${TEEMILL_TOGGLE_VERSION_INSTALLED_FN:-}" || -n "${TEEMILL_TOGGLE_VERSION_TARGET_FN:-}" ]]; then
      if [[ "${row_installed[j]:-0}" -eq 1 ]]; then
        marker='[✓]'
        printf '  \e[32m%s  %2d  %-12s  %-14s  %-14s  %s\e[0m\n' "$marker" "$index" "$display_id" "$vi" "$vt" "$description" >&2
      else
        if is_id_in_default_list "$default_ids_string" "$display_id"; then
          marker="*"
        fi

        printf '  %s  %2d  %-12s  %-14s  %-14s  %s\n' "$marker" "$index" "$display_id" "$vi" "$vt" "$description" >&2
      fi
    else
      if [[ "${row_installed[j]:-0}" -eq 1 ]]; then
        marker='[✓]'
        printf '  \e[32m%s  %2d  %-20s  %s\e[0m\n' "$marker" "$index" "$display_id" "$description" >&2
      else
        if is_id_in_default_list "$default_ids_string" "$display_id"; then
          marker="*"
        fi

        printf '  %s  %2d  %-20s  %s\n' "$marker" "$index" "$display_id" "$description" >&2
      fi
    fi

    index=$((index + 1))
  done

  echo >&2
  echo "  ${footer_default_hint}" >&2

  if [[ -n "${footer_installed_hint}" ]]; then
    echo "  ${footer_installed_hint}" >&2
  fi

  echo "  Enter: 1-based numbers (spaces or commas), ranges like 3-5, \"all\", \"none\", or empty for defaults." >&2
  printf '  %s' "$prompt_label" >&2

  reply=""

  if [[ -r /dev/tty ]]; then
    read -r reply </dev/tty || true
  else
    read -r reply || true
  fi

  normalized="${reply//,/ }"
  normalized="${normalized#"${normalized%%[![:space:]]*}"}"
  normalized="${normalized%"${normalized##*[![:space:]]}"}"

  if [[ -z "$normalized" ]]; then
    for ((j = 0; j < count; j++)); do
      manifest_line="${manifest_lines[j]}"
      display_id="$(manifest_field "$manifest_line" 1)"

      if [[ "${row_installed[j]:-0}" -eq 1 ]]; then
        continue
      fi

      if is_id_in_default_list "$default_ids_string" "$display_id"; then
        echo "$display_id"
      fi
    done

    return
  fi

  if [[ "${normalized,,}" == "none" ]]; then
    return
  fi

  if [[ "${normalized,,}" == "all" ]]; then
    for ((j = 0; j < count; j++)); do
      manifest_line="${manifest_lines[j]}"

      if [[ "${row_installed[j]:-0}" -eq 1 ]]; then
        continue
      fi

      manifest_field "$manifest_line" 1
    done

    return
  fi

  declare -A picked=()

  for token in $normalized; do
    if [[ "$token" =~ ^([1-9][0-9]*)-([1-9][0-9]*)$ ]]; then
      start="${BASH_REMATCH[1]}"
      end="${BASH_REMATCH[2]}"

      if [[ "$start" -gt "$end" ]]; then
        local swap="$start"
        start="$end"
        end="$swap"
      fi

      if [[ "$end" -gt "$count" ]] || [[ "$start" -lt 1 ]]; then
        echo "teemill-install: range out of bounds: $token (valid 1-$count)" >&2
        exit 2
      fi

      for ((j = start; j <= end; j++)); do
        picked[$j]=1
      done

      continue
    fi

    if [[ "$token" =~ ^[1-9][0-9]*$ ]]; then
      if [[ "$token" -lt 1 ]] || [[ "$token" -gt "$count" ]]; then
        echo "teemill-install: index out of bounds: $token (valid 1-$count)" >&2
        exit 2
      fi

      picked[$token]=1
      continue
    fi

    echo "teemill-install: could not parse token: $token (use numbers, ranges, all, or none)" >&2
    exit 2
  done

  for ((i = 1; i <= count; i++)); do
    if [[ -n "${picked[$i]:-}" ]]; then
      if [[ "${row_installed[i - 1]:-0}" -eq 1 ]]; then
        continue
      fi

      manifest_line="${manifest_lines[i - 1]}"
      manifest_field "$manifest_line" 1
    fi
  done
}

prompt_repo_ids_fallback_numbers() {
  local teemill_root="$1"
  shift

  TEEMILL_TOGGLE_VERSION_INSTALLED_FN=_teemill_toggle_repo_installed_version
  TEEMILL_TOGGLE_VERSION_TARGET_FN=_teemill_toggle_repo_target_version

  prompt_toggle_ids_fallback_numbers \
    "$teemill_root" \
    "Teemill repos (clone into: $teemill_root)  (no TTY: type numbers instead of arrow keys)" \
    is_manifest_repo_installed \
    "$DEFAULT_SELECTED_IDS" \
    "* = default clone set (only repos not already installed)." \
    "[✓] = already cloned under this path (skipped for defaults, \"all\", and numbers)." \
    "Which to clone? [default bundle] " \
    "$@"

  unset TEEMILL_TOGGLE_VERSION_INSTALLED_FN TEEMILL_TOGGLE_VERSION_TARGET_FN
}


emit_default_repo_ids_for_teemill_root() {
  local teemill_root="$1"
  local manifest_line display_id

  if [[ -d "$teemill_root" ]]; then
    teemill_root="$(cd -- "$teemill_root" && pwd)"
  fi

  while IFS= read -r manifest_line; do
    [[ -z "$manifest_line" ]] && continue
    display_id="$(manifest_field "$manifest_line" 1)"

    if is_manifest_repo_installed "$teemill_root" "$manifest_line"; then
      continue
    fi

    if is_selected_by_default "$display_id"; then
      echo "$display_id"
    fi
  done < <(parse_manifest_lines)
}

prompt_tool_ids_fallback_numbers() {
  TEEMILL_TOGGLE_VERSION_INSTALLED_FN=_teemill_toggle_toolchain_installed_version
  TEEMILL_TOGGLE_VERSION_TARGET_FN=_teemill_toggle_toolchain_target_version

  prompt_toggle_ids_fallback_numbers \
    "" \
    "Toolchain packages  (no TTY: type numbers instead of arrow keys)" \
    _toolchain_manifest_line_installed \
    "$DEFAULT_SELECTED_TOOL_IDS" \
    "* = default toolchain bundle." \
    "" \
    "Which tools to install? [default bundle] " \
    "$@"

  unset TEEMILL_TOGGLE_VERSION_INSTALLED_FN TEEMILL_TOGGLE_VERSION_TARGET_FN
}

prompt_tool_ids_cli() {
  local -a manifest_lines=()
  local manifest_line

  while IFS= read -r manifest_line; do
    [[ -z "$manifest_line" ]] && continue
    manifest_lines+=("$manifest_line")
  done < <(parse_tool_manifest_lines)

  if [[ "${#manifest_lines[@]}" -eq 0 ]]; then
    echo "teemill-install: internal error: empty tool manifest." >&2
    exit 2
  fi

  if arrow_menu_tty_available; then
    local menu_status=0

    run_tool_arrow_menu "${manifest_lines[@]}" || menu_status=$?

    if [[ "$menu_status" -eq 2 ]]; then
      prompt_tool_ids_fallback_numbers "${manifest_lines[@]}"
    fi

    return
  fi

  prompt_tool_ids_fallback_numbers "${manifest_lines[@]}"
}

main() {
  local teemill_root="$DEFAULT_TEEMILL_ROOT"
  local dry_run="false"
  local assume_yes="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --root)
        teemill_root="${2:-}"

        if [[ -z "$teemill_root" ]]; then
          echo "teemill-install: --root needs a directory argument." >&2
          exit 2
        fi

        shift 2
        ;;
      --yes | -y)
        assume_yes="true"
        shift
        ;;
      --dry-run)
        dry_run="true"
        shift
        ;;
      --list)
        echo "Known repositories (id | directory | url):"

        while IFS= read -r manifest_line; do
          [[ -z "$manifest_line" ]] && continue
          list_id="$(manifest_field "$manifest_line" 1)"
          list_url="$(manifest_field "$manifest_line" 3)"
          list_dir="$(manifest_field "$manifest_line" 4)"
          [[ -z "$list_dir" ]] && list_dir="$list_id"
          printf '  %-22s %-22s %s\n' "$list_id" "$list_dir" "$list_url"
        done < <(parse_manifest_lines)

        exit 0
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        echo "teemill-install: unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
  done

  local selected_tools_line=""
  local -a selected_tool_ids_array=()

  if [[ "$assume_yes" == "true" ]]; then
    _teemill_install_major_step "Toolchain: defaults (--yes)"
    echo "" >&2
    selected_tools_line="$DEFAULT_SELECTED_TOOL_IDS"
  else
    _teemill_install_major_step "Toolchain: interactive selection"
    echo "" >&2
    mapfile -t selected_tool_ids_array < <(prompt_tool_ids_cli)
    selected_tools_line="${selected_tool_ids_array[*]}"
  fi

  _teemill_install_major_step "Bootstrap: workspace, toolchain, auth"
  echo "" >&2

  bootstrap_environment "$teemill_root" "$assume_yes" "$dry_run" "$selected_tools_line"

  if [[ -d "$teemill_root" ]]; then
    teemill_root="$(cd -- "$teemill_root" && pwd)"
  fi

  bootstrap_ubuntu_gnome_favorite_apps "skip"

  local -a chosen_ids=()

  _teemill_install_major_step "Teemill repositories: selection and clones"
  echo "" >&2

  if [[ "$assume_yes" == "true" ]]; then
    mapfile -t chosen_ids < <(emit_default_repo_ids_for_teemill_root "$teemill_root")
  else
    mapfile -t chosen_ids < <(prompt_repo_ids_cli "$teemill_root")
  fi

  if [[ "${#chosen_ids[@]}" -eq 0 ]]; then
    echo "teemill-install: nothing selected; exiting." >&2
    exit 0
  fi

  local chosen match_line url dest_path

  for chosen in "${chosen_ids[@]}"; do
    [[ -z "$chosen" ]] && continue

    match_line=""

    while IFS= read -r manifest_line; do
      id="$(manifest_field "$manifest_line" 1)"

      if [[ "$id" == "$chosen" ]]; then
        match_line="$manifest_line"
        break
      fi
    done < <(parse_manifest_lines)

    if [[ -z "$match_line" ]]; then
      echo "teemill-install: unknown repo id from selection: $chosen" >&2
      exit 2
    fi

    url="$(manifest_field "$match_line" 3)"
    dest_path="$(manifest_clone_target_path "$teemill_root" "$match_line")"

    if is_manifest_repo_installed "$teemill_root" "$match_line"; then
      echo "teemill-install: skip (already a git repo): $(manifest_clone_target_path "$teemill_root" "$match_line")" >&2
      continue
    fi

    if [[ -e "$dest_path" ]]; then
      echo "teemill-install: skip (path exists and is not an empty git clone target): $dest_path" >&2
      continue
    fi

    # frontend + frontend-legacy share a large tree; partial clone keeps initial fetch small.
    local clone_cmd=(git clone)

    if [[ "$chosen" == "frontend" || "$chosen" == "frontend-legacy" ]]; then
      clone_cmd+=(--filter=blob:none)
    fi

    clone_cmd+=("$url" "$dest_path")

    if [[ "$dry_run" == "true" ]]; then
      printf '%q ' "${clone_cmd[@]}"
      echo
      continue
    fi

    echo "teemill-install: cloning $chosen -> $dest_path" >&2
    "${clone_cmd[@]}"
  done
}

main "$@"
