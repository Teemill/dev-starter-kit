  if id -nG "$target_user" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
    echo "user ${target_user} is already in the docker group." >&2
    return 0
  fi

  banner "Docker: add ${target_user} to docker group"

  if pkg_as_root usermod -aG docker "$target_user"; then
    echo "re-login or run: newgrp docker" >&2
  fi
}

