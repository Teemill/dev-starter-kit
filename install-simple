repo_clone() {
  local id="${1:?}"
  local url="${2:?}"
  local dirname="${3:?}"
  local partial="${4:-0}"
  local dest="$TEEMILL_ROOT/$dirname"

  if [[ -d "$dest/.git" ]]; then
    echo "skip (already a repo): $dest" >&2
    return 0
  fi

  if [[ -e "$dest" ]] && [[ ! -d "$dest" ]]; then
    echo "skip (path exists): $dest" >&2
    return 0
  fi

  mkdir -p "$(dirname "$dest")" || return 1

  if [[ "$partial" == "1" ]]; then
    echo "cloning $id -> $dest (partial)" >&2
    git clone --filter=blob:none "$url" "$dest"
  else
    echo "cloning $id -> $dest" >&2
    git clone "$url" "$dest"
  fi
}

repo_head_version() {
  local dir="${1:?}"

  if [[ -d "$dir/.git" ]]; then
    git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo ""
  else
    echo ""
  fi
}

