#!/usr/bin/env bash
#
# Teemill dev bootstrap (Ubuntu + apt). Interactive arrow/Space menus pick toolchain
# packages and repositories, then installs, configures GitHub/gcloud/docker, and clones.
#
#   bash install-simple
#   TEEMILL_ROOT=~/src/teemill bash install-simple
#
set -u

readonly DEFAULT_TEEMILL_ROOT="${TEEMILL_ROOT:-$HOME/teemill}"
TEEMILL_ROOT=""
# Space-separated tool ids after the toolchain menu (e.g. "curl git gh gcloud docker").
SELECTED_TOOLS_LINE=""

readonly TOOL_IDS_ORDER="curl git gh gcloud docker kubectl helm terraform"

# Shared helpers
# ---------------------------------------------------------------------------

pkg_as_root() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "need root or sudo for: $*" >&2
    return 1
  fi
}

http_get_body() {
  local url="${1:?}"
  local connect_seconds="${2:-6}"
  local max_seconds="${3:-25}"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout "$connect_seconds" --max-time "$max_seconds" "$url" 2>/dev/null || true
    return 0
  fi

  if command -v wget >/dev/null 2>&1; then
    wget -qO- --timeout="$max_seconds" "$url" 2>/dev/null || true
  fi
}

http_get_github_json() {
  local url="${1:?}"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 6 --max-time 22 \
      -H 'Accept: application/vnd.github+json' \
      -H 'User-Agent: TeemillDevStarterKit/1' \
      "$url" 2>/dev/null || true
    return 0
  fi

  if command -v wget >/dev/null 2>&1; then
    wget -qO- --timeout=25 "$url" 2>/dev/null || true
  fi
}

github_latest_tag() {
  local url="${1:?}"
  local body

  body="$(http_get_github_json "$url")"
  echo "$body" | grep -m1 -oE '"tag_name"[[:space:]]*:[[:space:]]*"[^"]+"' | sed -E 's/.*"([^"]+)".*/\1/' | sed -E 's/^v//'
}

banner() {
  echo "" >&2
  echo "--- $* ---" >&2
}

apt_cache_has() {
  apt-cache show "$1" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Menu support: toolchain / repo installed + target columns
# ---------------------------------------------------------------------------

toggle_version_or_dash() {
  local value="${1:-}"
  value="${value//$'\n'/ }"
  value="${value//[[:space:]]/}"
  if [[ -z "$value" ]]; then
    printf '-'
    return
  fi
  if [[ "${#value}" -gt 14 ]]; then
    printf '%s' "${value:0:14}"
    return
  fi
  printf '%s' "$value"
}

toolchain_manifest_line_installed() {
  local _root="$1"
  local manifest_line="$2"
  local tool_id v fn
  tool_id="$(manifest_field "$manifest_line" 1)"
  fn="version_${tool_id}"
  declare -f "$fn" >/dev/null 2>&1 || return 1
  v="$("$fn")"
  [[ -n "${v// }" ]]
}

toggle_toolchain_installed_version() {
  local _root="$1"
  local manifest_line="$2"
  local tool_id raw fn
  tool_id="$(manifest_field "$manifest_line" 1)"
  fn="version_${tool_id}"
  raw=""
  declare -f "$fn" >/dev/null 2>&1 && raw="$("$fn")"
  toggle_version_or_dash "$raw"
}

toggle_toolchain_target_version() {
  local _root="$1"
  local manifest_line="$2"
  local tool_id raw fn
  tool_id="$(manifest_field "$manifest_line" 1)"
  fn="upstream_${tool_id}"
  raw=""
  declare -f "$fn" >/dev/null 2>&1 && raw="$("$fn")"
  toggle_version_or_dash "$raw"
}

version_repo_for_menu() {
  local teemill_root="${1:?}"
  local manifest_line="${2:?}"
  local dest
  dest="$(manifest_clone_target_path "$teemill_root" "$manifest_line")"
  if [[ ! -d "$dest/.git" ]]; then
    echo ""
    return
  fi
  git -C "$dest" rev-parse --short HEAD 2>/dev/null || echo ""
}

upstream_repo_for_menu() {
  local _root="${1:?}"
  local manifest_line="${2:?}"
  local url head
  url="$(manifest_field "$manifest_line" 3)"
  if [[ -z "$url" ]]; then
    echo ""
    return
  fi
  head="$(GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=5" timeout 10 git ls-remote "$url" HEAD 2>/dev/null | awk '{print substr($1,1,9)}')"
  echo "$head"
}

toggle_repo_installed_version() {
  local teemill_root="$1"
  local manifest_line="$2"
  local raw
  raw="$(version_repo_for_menu "$teemill_root" "$manifest_line")"
  raw="${raw//$'\n'/ }"
  raw="${raw//[[:space:]]/}"
  toggle_version_or_dash "$raw"
}

toggle_repo_target_version() {
  local teemill_root="$1"
  local manifest_line="$2"
  local raw
  raw="$(upstream_repo_for_menu "$teemill_root" "$manifest_line")"
  raw="${raw//$'\n'/ }"
  raw="${raw//[[:space:]]/}"
  toggle_version_or_dash "$raw"
}


