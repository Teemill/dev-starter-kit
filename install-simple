# ---------------------------------------------------------------------------
# Steps (main runs these in order after menus)
# ---------------------------------------------------------------------------

selected_contains() {
  local want="${1:?}"
  local id="${2:?}"
  local x
  for x in $want; do
    if [[ "$x" == "$id" ]]; then
      return 0
    fi
  done
  return 1
}

step_require_ubuntu() {
  if ! command -v apt-get >/dev/null 2>&1; then
    echo "install-simple requires Ubuntu/Debian with apt-get." >&2
    exit 2
  fi
  local os_id=""
  if [[ -r /etc/os-release ]]; then
    os_id="$(grep -E '^ID=' /etc/os-release 2>/dev/null | head -n1 | cut -d= -f2- | tr -d '"' | tr -d "'")"
    os_id="${os_id#"${os_id%%[![:space:]]*}"}"
    os_id="${os_id%"${os_id##*[![:space:]]}"}"
  fi
  if [[ "$os_id" != "ubuntu" ]]; then
    echo "install-simple targets Ubuntu (found ID=${os_id:-unknown}). Continuing." >&2
  fi
}

step_prepare_workspace() {
  mkdir -p "$TEEMILL_ROOT" || {
    echo "could not create $TEEMILL_ROOT" >&2
    exit 2
  }
  TEEMILL_ROOT="$(cd -- "$TEEMILL_ROOT" && pwd)"
}

step_prepare_apt_sources() {
  export DEBIAN_FRONTEND=noninteractive
  local need_google=0 need_gh=0
  selected_contains "$SELECTED_TOOLS_LINE" gcloud && need_google=1
  selected_contains "$SELECTED_TOOLS_LINE" gh && need_gh=1

  banner "apt: update"
  pkg_as_root apt-get update -qq

  if [[ "$need_google" -eq 1 || "$need_gh" -eq 1 ]]; then
    pkg_as_root apt-get install -y -qq ca-certificates curl gnupg dirmngr apt-transport-https
  else
    pkg_as_root apt-get install -y -qq ca-certificates || true
  fi

  local google_list=/etc/apt/sources.list.d/google-cloud-sdk.list
  local google_key=/usr/share/keyrings/google-cloud-teemill.gpg
  if [[ "$need_google" -eq 1 && ! -f "$google_list" ]]; then
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | pkg_as_root gpg --batch --yes --dearmor -o "$google_key"
    echo "deb [signed-by=${google_key}] https://packages.cloud.google.com/apt cloud-sdk main" | pkg_as_root tee "$google_list" >/dev/null
  fi

  local gh_list=/etc/apt/sources.list.d/github-cli.list
  local gh_key=/usr/share/keyrings/githubcli-archive-keyring.gpg
  if [[ "$need_gh" -eq 1 && ! -f "$gh_list" ]]; then
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | pkg_as_root tee "$gh_key" >/dev/null
    pkg_as_root chmod go+r "$gh_key" 2>/dev/null || true
    echo "deb [arch=$(dpkg --print-architecture) signed-by=${gh_key}] https://cli.github.com/packages stable main" | pkg_as_root tee "$gh_list" >/dev/null
  fi

  if [[ "$need_google" -eq 1 || "$need_gh" -eq 1 ]]; then
    pkg_as_root apt-get update -qq
  fi
}

step_install_toolchain() {
  banner "Install selected toolchain packages"
  local id
  for id in $TOOL_IDS_ORDER; do
    selected_contains "$SELECTED_TOOLS_LINE" "$id" || continue
    if declare -f "install_${id}" >/dev/null 2>&1; then
      "install_${id}"
    fi
  done
}

step_print_versions() {
  banner "Installed vs upstream (selected tools)"
  printf '%-12s %-18s %s\n' "tool" "installed" "upstream" >&2
  printf '%-12s %-18s %s\n' "----" "----------" "--------" >&2
  local id vfn ufn
  for id in $TOOL_IDS_ORDER; do
    selected_contains "$SELECTED_TOOLS_LINE" "$id" || continue
    vfn="version_${id}"
    ufn="upstream_${id}"
    printf '%-12s %-18s %s\n' "$id" "$("$vfn")" "$("$ufn")" >&2
  done
}

step_run_tool_setups() {
  local id
  for id in $TOOL_IDS_ORDER; do
    selected_contains "$SELECTED_TOOLS_LINE" "$id" || continue
    case "$id" in
      git | gh | gcloud) continue ;;
    esac
    declare -f "setup_${id}" >/dev/null 2>&1 && "setup_${id}"
  done
  selected_contains "$SELECTED_TOOLS_LINE" gcloud && setup_gcloud
  selected_contains "$SELECTED_TOOLS_LINE" git && setup_git
  selected_contains "$SELECTED_TOOLS_LINE" gh && setup_gh
}

step_prompt_toolchain_menu() {
  banner "Toolchain selection"
  local -a picked=()
  mapfile -t picked < <(prompt_tool_ids_cli)
  SELECTED_TOOLS_LINE="${picked[*]}"
  echo "selected tools: ${SELECTED_TOOLS_LINE:-<none>}" >&2
}

step_prompt_repo_menu() {
  banner "Repository selection"
  local -a picked=()
  mapfile -t picked < <(prompt_repo_ids_cli "$TEEMILL_ROOT")
  printf '%s\n' "${picked[@]}"
}

step_clone_selected_repos() {
  local -a ids=()
  mapfile -t ids < <(step_prompt_repo_menu)
  if [[ "${#ids[@]}" -eq 0 ]]; then
    echo "no repositories selected; skipping clones." >&2
    return 0
  fi
  banner "Clone Teemill repositories (SSH)"
  local rid safe fn
  for rid in "${ids[@]}"; do
    rid="${rid// /}"
    [[ -z "$rid" ]] && continue
    safe="${rid//-/_}"
    fn="install_repo_${safe}"
    if declare -f "$fn" >/dev/null 2>&1; then
      "$fn"
    else
      echo "unknown repository id: $rid" >&2
      exit 2
    fi
  done
}

usage() {
  cat <<'EOF'
Usage: bash install-simple

  Ubuntu + apt. Arrow keys + Space toggle toolchain packages and repositories; Enter confirms.
  Without a TTY, use numbered multi-select. TEEMILL_ROOT defaults to ~/teemill.

  Optional: TEEMILL_ROOT=/path/to/workspace bash install-simple
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
  if [[ $# -gt 0 ]]; then
    echo "install-simple takes no arguments (use TEEMILL_ROOT). Got: $*" >&2
    usage >&2
    exit 2
  fi

  TEEMILL_ROOT="$DEFAULT_TEEMILL_ROOT"

  step_require_ubuntu
  step_prepare_workspace
  step_prompt_toolchain_menu

  if [[ -z "${SELECTED_TOOLS_LINE// }" ]]; then
    echo "no toolchain packages selected; skipping installs and auth helpers that need tools." >&2
  else
    step_prepare_apt_sources
    step_install_toolchain
    step_print_versions
    step_run_tool_setups
  fi

  step_clone_selected_repos

  banner "Done"
  echo "workspace: $TEEMILL_ROOT" >&2
}

main "$@"
