prompt_tool_ids_cli() {
  local -a manifest_lines=()
  local manifest_line

  while IFS= read -r manifest_line; do
    [[ -z "$manifest_line" ]] && continue
    manifest_lines+=("$manifest_line")
  done < <(parse_tool_manifest_lines)

  if [[ "${#manifest_lines[@]}" -eq 0 ]]; then
    echo "internal error: empty tool manifest." >&2
    exit 2
  fi

  if arrow_menu_tty_available; then
    local menu_status=0

    run_tool_arrow_menu "${manifest_lines[@]}" || menu_status=$?

    if [[ "$menu_status" -eq 2 ]]; then
      prompt_tool_ids_fallback_numbers "${manifest_lines[@]}"
