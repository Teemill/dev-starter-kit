setup_gh() {
  local gh_authenticated="false"
  local git_name_val=""
  local git_email_val=""
  local api_login=""

  banner "GitHub CLI: gh auth and git helper"

  if gh config set -h github.com git_protocol ssh 2>/dev/null; then
    :
  elif gh config set git_protocol ssh 2>/dev/null; then
    echo "set gh git_protocol ssh globally." >&2
  else
    echo "could not set gh git_protocol ssh." >&2
  fi

  if gh auth status -h github.com >/dev/null 2>&1; then
    gh_authenticated="true"
  elif gh auth status 2>&1 | grep -qi 'Logged in to github.com'; then
    gh_authenticated="true"
  fi

  if [[ "$gh_authenticated" != "true" ]]; then
    if [[ -t 1 ]] && [[ -r /dev/tty ]] && [[ -w /dev/tty ]]; then
      echo "launching gh auth login (github.com, SSH, web)." >&2
      gh auth login -h github.com --git-protocol ssh --web </dev/tty && gh_authenticated="true"
    else
      echo "not a TTY; run: gh auth login -h github.com --git-protocol ssh --web" >&2
    fi
  else
    echo "gh is already logged in to github.com." >&2
  fi

  if [[ "$gh_authenticated" == "true" ]]; then
    gh auth setup-git -h github.com >/dev/null 2>&1 || gh auth setup-git >/dev/null 2>&1 || true

    git_name_val="$(git config --global --get user.name 2>/dev/null || true)"
    git_email_val="$(git config --global --get user.email 2>/dev/null || true)"

    if [[ -z "$git_name_val" ]] || [[ -z "$git_email_val" ]]; then
      api_login="$(GH_HOST=github.com gh api user -q .login 2>/dev/null || true)"

      if [[ -n "$api_login" ]]; then
        [[ -n "$git_name_val" ]] || git config --global user.name "$api_login" || true
        [[ -n "$git_email_val" ]] || git config --global user.email "${api_login}@users.noreply.github.com" || true
      fi
    fi
  fi
}

